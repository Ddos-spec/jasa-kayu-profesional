---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/blog/**/*.{jpeg,jpg,png,gif,svg}');
const posts = await Promise.all((await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map(async (post) => {
    const path = (post.data.image ?? '/images/blog/blog-1.jpg').replace(/^\/images\/blog\//, '/src/assets/images/blog/');
    const image = images[path] ? (await images[path]()).default : (await images['/src/assets/images/blog/blog-1.jpg']()).default;
    return { ...post, image };
  }));
const featured = posts[0];
const remaining = posts.slice(1);
const date = (value: Date) => new Intl.DateTimeFormat('id-ID', { year: 'numeric', month: 'short', day: 'numeric' }).format(value);
---
<Layout title="Jurnal Material & Ruang | Jasa Kayu Profesional" description="Panduan praktis seputar kayu, decking, lantai, perawatan, dan persiapan proyek dari Jasa Kayu Profesional." canonical="https://www.jasakayuprofesional.com/blog/">
  <section class="bg-[#f4f2eb] pb-24 pt-32 sm:pt-40">
    <div class="section-shell"><div class="grid gap-8 border-b border-[#17231d]/15 pb-10 lg:grid-cols-[.75fr_1.25fr] lg:items-end"><div><p class="section-kicker">Jurnal material</p></div><div><h1 class="display-title text-balance text-5xl text-[#17231d] sm:text-6xl lg:text-7xl">Catatan untuk membuat keputusan ruang yang lebih <em>baik.</em></h1><p class="mt-6 max-w-2xl text-base leading-7 text-[#566158]">Panduan yang membahas kondisi nyata di lapangan: material, perawatan, detail instalasi, dan persiapan proyek sebelum pengerjaan dimulai.</p></div></div>
      {featured && <article class="mt-12 grid overflow-hidden border border-[#17231d]/15 bg-[#e7dfd0] lg:grid-cols-[1.1fr_.9fr]"><a href={`/blog/${featured.id}/`} class="image-zoom block aspect-[5/3] bg-[#d1c6b3] lg:aspect-auto"><Image src={featured.image} alt={featured.data.title} width={1000} height={700} format="webp" loading="eager" fetchpriority="high" class="h-full w-full object-cover" /></a><div class="flex flex-col justify-between p-7 sm:p-10"><div><p class="text-[.62rem] font-extrabold uppercase tracking-[.14em] text-[#315443]">{featured.data.category ?? 'Jurnal material'} · {date(featured.data.pubDate)}</p><h2 class="mt-4 font-serif text-4xl font-semibold leading-[.95] tracking-[-.045em] text-[#17231d] sm:text-5xl">{featured.data.title}</h2><p class="mt-5 text-sm leading-7 text-[#566158]">{featured.data.description}</p></div><a href={`/blog/${featured.id}/`} class="mt-8 inline-flex items-center gap-3 text-[.67rem] font-extrabold uppercase tracking-[.13em] text-[#315443]">Baca panduan <span class="text-lg" aria-hidden="true">↗</span></a></div></article>}
      <div class="mt-14 grid gap-x-5 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">{remaining.map((post) => <article class="group"><a href={`/blog/${post.id}/`} class="image-zoom block aspect-[4/3] bg-[#d1c6b3]"><Image src={post.image} alt={post.data.title} width={640} height={480} format="webp" loading="lazy" class="h-full w-full object-cover" /></a><p class="mt-4 text-[.6rem] font-extrabold uppercase tracking-[.14em] text-[#315443]">{post.data.category ?? 'Jurnal material'} · {date(post.data.pubDate)}</p><a href={`/blog/${post.id}/`} class="mt-2 block font-serif text-3xl font-semibold leading-[.98] tracking-[-.04em] text-[#17231d] transition group-hover:text-[#315443]">{post.data.title}</a><p class="mt-3 text-sm leading-6 text-[#59645b]">{post.data.description}</p></article>)}</div>
    </div>
  </section>
</Layout>
