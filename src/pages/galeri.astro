---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/portfolio/**/*.{jpeg,jpg,png,gif,svg,webp}');
const portfolio = await Promise.all((await getCollection('portfolio')).sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0)).map(async (item) => {
  const path = item.data.image?.startsWith('/images/portfolio/') ? `/src/assets${item.data.image}` : item.data.image;
  const image = path && images[path] ? (await images[path]()).default : (await images['/src/assets/images/portfolio/portfolio-1.svg']()).default;
  return { ...item, image };
}));
---
<Layout title="Galeri Karya | Jasa Kayu Profesional" description="Dokumentasi proyek lantai kayu, decking, tangga, ceiling, wall panel, dan detail custom oleh Jasa Kayu Profesional." canonical="https://www.jasakayuprofesional.com/galeri">
  <section class="bg-[#f4f2eb] pb-24 pt-32 sm:pt-40"><div class="section-shell"><div class="grid gap-8 border-b border-[#17231d]/15 pb-10 lg:grid-cols-[.75fr_1.25fr] lg:items-end"><div><p class="section-kicker">Galeri karya</p></div><div><h1 class="display-title text-balance text-5xl text-[#17231d] sm:text-6xl lg:text-7xl">Material yang terasa lebih hidup saat masuk ke <em>ruang.</em></h1><p class="mt-6 max-w-2xl text-base leading-7 text-[#566158]">Pilihan dokumentasi proyek untuk memberi gambaran tentang karakter material, komposisi, dan detail pengerjaan.</p></div></div><div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{portfolio.map((item) => <a href={`/portfolio/${item.id}`} class="group"><div class="image-zoom aspect-[4/3] bg-[#ded6c7]"><Image src={item.image} alt={item.data.title} width={720} height={540} loading="lazy" format="webp" class="h-full w-full object-cover" /></div><p class="mt-4 text-[.6rem] font-extrabold uppercase tracking-[.14em] text-[#315443]">{item.data.displayCategory}</p><h2 class="mt-2 font-serif text-3xl font-semibold leading-[.96] tracking-[-.04em] text-[#17231d] group-hover:text-[#315443]">{item.data.title}</h2></a>)}</div></div></section>
</Layout>
