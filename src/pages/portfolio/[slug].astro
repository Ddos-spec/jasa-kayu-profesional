---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import ImageGallery from '../../components/ImageGallery.astro';

// Get all portfolio entries
const allPortfolios = await getCollection('portfolio');
// Find the specific portfolio based on the slug
export async function getStaticPaths() {
  const portfolios = await getCollection('portfolio');
  return portfolios.map((portfolio) => ({
    params: { slug: portfolio.id },
    props: { portfolio },
  }));
}

const { portfolio } = Astro.props;
const { Content } = await render(portfolio);

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/portfolio/**/*.{jpeg,jpg,png,gif,svg}');

const fallbackPaths = [
  '/src/assets/images/portfolio/portfolio-1.svg',
  '/src/assets/images/portfolio/portfolio-2.svg',
  '/src/assets/images/portfolio/portfolio-3.svg',
  '/src/assets/images/portfolio/portfolio-4.svg',
  '/src/assets/images/portfolio/portfolio-5.svg',
  '/src/assets/images/portfolio/portfolio-6.svg'
];

const toAssetImagePath = (imagePath?: string, slug?: string) => {
  if (!imagePath) {
    return slug ? `/src/assets/images/portfolio/${slug}.jpg` : undefined;
  }

  if (imagePath.startsWith('/src/assets/images/portfolio/')) {
    return imagePath;
  }

  if (imagePath.startsWith('/images/portfolio/')) {
    return `/src/assets${imagePath}`;
  }

  return imagePath;
};

const resolveImageMetadata = async (imagePath?: string, fallbackPath = fallbackPaths[0]) => {
  if (imagePath && images[imagePath]) {
    return (await images[imagePath]()).default;
  }

  return (await images[fallbackPath]()).default;
};

const imagePath = toAssetImagePath(portfolio.data.image, portfolio.id);
const mainImage = await resolveImageMetadata(imagePath);
const galleryImages = await Promise.all((portfolio.data.gallery ?? []).map(async (path, index) => ({
  src: await resolveImageMetadata(toAssetImagePath(path), fallbackPaths[(index + 1) % fallbackPaths.length]),
  alt: `${portfolio.data.title} - dokumentasi proyek ${index + 2}`,
  caption: `Dokumentasi proyek ${index + 2}`
})));
const allPortfolioImages = [portfolio.data.image, ...(portfolio.data.gallery ?? [])].filter(Boolean);

// Set SEO variables
const seoTitle = portfolio.data.seoTitle || `${portfolio.data.title} | Portfolio | Jasa Kayu Profesional`;
const seoDescription = portfolio.data.seoDescription || portfolio.data.description;
const keywords = portfolio.data.keywords || 'finishing kayu, portfolio, proyek kayu, lantai kayu, dinding kayu';

// Set canonical URL
const canonical = `https://www.jasakayuprofesional.com/portfolio/${portfolio.id}`;

const otherProjects = await Promise.all(
  allPortfolios
    .filter(p => p.id !== portfolio.id)
    .slice(0, 2)
    .map(async (p, i) => {
      const pImagePath = toAssetImagePath(p.data.image, p.id);
      const pImage = await resolveImageMetadata(pImagePath, fallbackPaths[i % fallbackPaths.length]);
      return { ...p, pImage };
    })
);
---

<Layout title={seoTitle} description={seoDescription} canonical={canonical}>

<!-- Schema Markup for the specific portfolio item -->
<script type="application/ld+json">
  {JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "name": portfolio.data.title,
    "alternateName": [seoTitle],
    "description": seoDescription,
    "about": "Finishing kayu profesional",
    "genre": portfolio.data.category,
    "dateCreated": `${portfolio.data.year || new Date().getFullYear()}-01-01`,
    "creator": {
      "@type": "Organization",
      "name": "Jasa Kayu Profesional",
      "url": "https://www.jasakayuprofesional.com/",
      "sameAs": [
        "https://www.facebook.com/jasakayuprofesional",
        "https://www.instagram.com/jasakayuprofesional"
      ],
      "telephone": "+6281283135295",
      "email": "info@jasakayuprofesional.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Jakarta",
        "addressCountry": "ID"
      }
    },
    "image": allPortfolioImages,
    "keywords": keywords,
    "hasPart": allPortfolioImages.map((image) => ({
      "@type": "ImageObject",
      "contentUrl": image
    }))
  })}
</script>

<div class="container mx-auto px-4 py-12 max-w-4xl">
  <div class="mb-8">
    <nav aria-label="Breadcrumb">
      <ol class="flex items-center space-x-2 text-sm text-wood-brown-600">
        <li><a href="/" class="hover:text-wood-brown-800 transition-colors">Home</a></li>
        <li><span class="text-gray-400">/</span></li>
        <li><a href="/#portofolio" class="hover:text-wood-brown-800 transition-colors">Portofolio</a></li>
        <li><span class="text-gray-400">/</span></li>
        <li class="text-wood-brown-800 font-semibold truncate max-w-[200px] md:max-w-none" aria-current="page">{portfolio.data.title}</li>
      </ol>
    </nav>
  </div>
  
  <article class="bg-white rounded-3xl shadow-lg overflow-hidden">
    <div class="relative w-full aspect-[4/3] md:aspect-[16/9] overflow-hidden">
      <Image
        src={mainImage}
        alt={portfolio.data.title}
        class="w-full h-full object-cover portfolio-detail-image"
        width={1200}
        height={675}
        format="webp"
      />
    </div>
    
    <div class="p-8">
      <div class="mb-6">
        <span class="text-xs font-bold uppercase tracking-widest text-wood-brown-700">{portfolio.data.displayCategory}</span>
        <h1 class="font-serif text-3xl md:text-4xl font-bold text-wood-brown-900 mt-3 leading-tight">{portfolio.data.title}</h1>
        <!-- Short description hidden on detail page to prevent keyword stuffing & redundancy -->
        <div class="mt-6 flex flex-wrap gap-3">
          {portfolio.data.year && <span class="text-sm font-medium bg-wood-brown-200 text-wood-brown-900 px-4 py-2 rounded-lg">Tahun: {portfolio.data.year}</span>}
          <span class="text-sm font-medium bg-wood-brown-200 text-wood-brown-900 px-4 py-2 rounded-lg">Kategori: {portfolio.data.displayCategory}</span>
          {portfolio.data.location && <span class="text-sm font-medium bg-wood-brown-200 text-wood-brown-900 px-4 py-2 rounded-lg">Lokasi: {portfolio.data.location}</span>}
        </div>
      </div>

      {(portfolio.data.location || portfolio.data.address) && (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 rounded-xl border border-wood-brown-200 bg-[#FFFBF2] p-8 mt-10">
          {portfolio.data.location && (
            <div>
              <p class="text-xs font-bold uppercase tracking-widest text-wood-brown-800">Area Proyek</p>
              <p class="mt-2 text-base font-medium text-gray-900">{portfolio.data.location}</p>
            </div>
          )}
          {portfolio.data.address && (
            <div>
              <p class="text-xs font-bold uppercase tracking-widest text-wood-brown-800">Alamat Ringkas</p>
              <p class="mt-2 text-base font-medium text-gray-900">{portfolio.data.address}</p>
            </div>
          )}
        </div>
      )}

      <div class="prose prose-lg prose-wood-brown mt-12 max-w-none text-gray-900 prose-p:text-left prose-p:max-w-[65ch]">
        <Content />
      </div>

      {galleryImages.length > 0 && (
        <div class="mt-10">
          <h2 class="font-serif text-2xl font-semibold text-wood-brown-800">Galeri Proyek</h2>
          <p class="mt-3 text-sm leading-relaxed text-[#4A4A4A]">
            Dokumentasi lapangan membantu calon klien melihat proporsi, struktur, dan hasil finishing proyek secara lebih nyata.
          </p>
          <ImageGallery images={galleryImages} columns={3} spacing="lg" />
        </div>
      )}

      <div class="mt-14 rounded-3xl bg-wood-brown-800 px-8 py-10 text-white">
        <h2 class="font-serif text-3xl font-semibold">Punya Kebutuhan Kayu Serupa?</h2>
        <p class="mt-4 max-w-2xl text-base font-medium leading-relaxed text-white">
          Kirim foto area, ukuran kasar, dan kebutuhan utama Anda lewat WhatsApp. Tim kami bantu arahkan material, scope kerja, dan langkah awal yang paling masuk akal.
        </p>
        <a
          href="/#kontak"
          class="mt-8 inline-flex items-center justify-center rounded-full bg-white px-8 py-4 text-base font-bold text-wood-brown-900 transition hover:bg-wood-brown-50 min-h-[48px]"
        >
          Konsultasi via WhatsApp
        </a>
      </div>
      
      <div class="mt-10 pt-8 border-t border-wood-brown-100">
        <h2 class="font-serif text-2xl font-semibold text-wood-brown-800 mb-4">Lihat Proyek Lainnya</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-8">
          {otherProjects.map((p) => (
              <a 
                href={`/portfolio/${p.id}`} 
                class="block group bg-white rounded-xl border border-wood-brown-100 hover:shadow-xl transition-all p-4"
              >
                <div class="overflow-hidden rounded-lg aspect-video w-full relative bg-gray-100">
                  <Image
                    src={p.pImage}
                    alt={p.data.title}
                    class="w-full h-full object-cover transition duration-500 group-hover:scale-110 portfolio-detail-image"
                    width={600}
                    height={337}
                    format="webp"
                  />
                </div>
                <div class="mt-5">
                  <span class="block text-xs font-bold uppercase tracking-widest text-wood-brown-500 mb-2">{p.data.displayCategory}</span>
                  <h3 class="font-serif text-xl font-bold text-wood-brown-900 group-hover:text-wood-brown-700 leading-snug">{p.data.title}</h3>
                  <p class="text-base text-gray-600 mt-3 line-clamp-2">{p.data.description}</p>
                </div>
              </a>
            ))}
        </div>
      </div>
    </div>
  </article>
</div>

</Layout>
