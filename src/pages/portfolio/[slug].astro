---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import ImageGallery from '../../components/ImageGallery.astro';

const allPortfolios = await getCollection('portfolio');
export async function getStaticPaths() {
  const portfolios = await getCollection('portfolio');
  return portfolios.map((portfolio) => ({ params: { slug: portfolio.id }, props: { portfolio } }));
}

const { portfolio } = Astro.props;
const { Content } = await render(portfolio);
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/portfolio/**/*.{jpeg,jpg,png,gif,svg,webp}');
const fallbackPaths = ['/src/assets/images/portfolio/portfolio-1.svg', '/src/assets/images/portfolio/portfolio-2.svg', '/src/assets/images/portfolio/portfolio-3.svg'];
const toAssetImagePath = (path?: string, slug?: string) => path?.startsWith('/images/portfolio/') ? `/src/assets${path}` : path || (slug ? `/src/assets/images/portfolio/${slug}.jpg` : undefined);
const resolveImage = async (path?: string, fallback = fallbackPaths[0]) => path && images[path] ? (await images[path]()).default : (await images[fallback]()).default;
const mainImage = await resolveImage(toAssetImagePath(portfolio.data.image, portfolio.id));
const galleryImages = await Promise.all((portfolio.data.gallery ?? []).map(async (path, index) => ({ src: await resolveImage(toAssetImagePath(path), fallbackPaths[index % fallbackPaths.length]), alt: `${portfolio.data.title} — dokumentasi ${index + 2}`, caption: `Dokumentasi proyek ${index + 2}` })));
const schemaImages = [portfolio.data.image, ...(portfolio.data.gallery ?? [])].filter(Boolean);
const seoTitle = portfolio.data.seoTitle || `${portfolio.data.title} | Portofolio Jasa Kayu Profesional`;
const seoDescription = portfolio.data.seoDescription || portfolio.data.description;
const otherProjects = await Promise.all(allPortfolios.filter((item) => item.id !== portfolio.id).slice(0, 2).map(async (item, index) => ({ ...item, image: await resolveImage(toAssetImagePath(item.data.image, item.id), fallbackPaths[index % fallbackPaths.length]) })));
---
<Layout title={seoTitle} description={seoDescription} canonical={`https://www.jasakayuprofesional.com/portfolio/${portfolio.id}`}>
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'CreativeWork', name: portfolio.data.title, description: seoDescription, genre: portfolio.data.category, dateCreated: `${portfolio.data.year ?? new Date().getFullYear()}-01-01`, creator: { '@type': 'Organization', name: 'Jasa Kayu Profesional', url: 'https://www.jasakayuprofesional.com/', telephone: '+6281283135295' }, image: schemaImages, keywords: portfolio.data.keywords })} />
  <article class="bg-[#f4f2eb] pb-24 pt-32 sm:pt-40">
    <header class="section-shell grid gap-8 border-b border-[#17231d]/15 pb-10 lg:grid-cols-[.7fr_1.3fr] lg:items-end">
      <div><a href="/#portofolio" class="section-kicker hover:text-[#17352a]">Kembali ke karya</a></div>
      <div><p class="text-[.65rem] font-extrabold uppercase tracking-[.15em] text-[#315443]">{portfolio.data.displayCategory} · {portfolio.data.location ?? 'Jabodetabek'}</p><h1 class="display-title text-balance mt-4 text-5xl text-[#17231d] sm:text-6xl lg:text-7xl">{portfolio.data.title}</h1><p class="mt-6 max-w-2xl text-base leading-7 text-[#566158] sm:text-lg">{portfolio.data.description}</p></div>
    </header>
    <div class="section-shell mt-10 max-w-[78rem]"><Image src={mainImage} alt={portfolio.data.title} class="aspect-[16/8] w-full object-cover" width={1500} height={750} loading="eager" fetchpriority="high" format="webp" /></div>
    <div class="section-shell mt-10 grid gap-10 lg:grid-cols-[10rem_minmax(0,45rem)] lg:justify-center">
      <aside class="hidden lg:block"><p class="text-[.6rem] font-extrabold uppercase tracking-[.15em] text-[#6c766d]">Ringkasan</p><dl class="mt-4 space-y-4 text-sm"><div><dt class="text-[#6c766d]">Kategori</dt><dd class="mt-1 font-bold text-[#17231d]">{portfolio.data.displayCategory}</dd></div>{portfolio.data.year && <div><dt class="text-[#6c766d]">Tahun</dt><dd class="mt-1 font-bold text-[#17231d]">{portfolio.data.year}</dd></div>}{portfolio.data.location && <div><dt class="text-[#6c766d]">Lokasi</dt><dd class="mt-1 font-bold text-[#17231d]">{portfolio.data.location}</dd></div>}</dl></aside>
      <div><div class="prose max-w-none"><Content /></div>{galleryImages.length > 0 && <section class="mt-14 border-t border-[#17231d]/15 pt-10"><p class="section-kicker">Dokumentasi</p><h2 class="mt-5 font-serif text-4xl font-semibold tracking-[-.04em] text-[#17231d]">Melihat detail lebih dekat</h2><p class="mt-3 max-w-xl text-sm leading-7 text-[#566158]">Dokumentasi lapangan untuk memahami proporsi, sistem bidang, dan hasil finishing proyek.</p><ImageGallery images={galleryImages} columns={3} spacing="lg" /></section>}<section class="mt-14 bg-[#17352a] p-7 text-white sm:p-10"><p class="section-kicker text-[#e6c88f]">Punya kebutuhan serupa?</p><h2 class="mt-5 font-serif text-4xl font-semibold leading-[.95] tracking-[-.04em]">Bawa foto area Anda.<br />Kita cek kemungkinan terbaiknya.</h2><p class="mt-5 max-w-xl text-sm leading-7 text-white/70">Mulai dari foto, ukuran kasar, lokasi, dan kebutuhan utama. Kami bantu arahkan diskusi ke material serta scope yang paling masuk akal.</p><a href="/#kontak" class="btn-wood mt-7 !bg-[#e6c88f] !text-[#17231d] hover:!bg-[#fffdf7]">Kirim brief proyek <span aria-hidden="true">↗</span></a></section></div>
    </div>
    <section class="section-shell mt-20 border-t border-[#17231d]/15 pt-10"><div class="flex items-end justify-between gap-6"><div><p class="section-kicker">Karya terkait</p><h2 class="mt-4 font-serif text-4xl font-semibold tracking-[-.04em] text-[#17231d]">Lanjutkan eksplorasi</h2></div><a href="/#portofolio" class="hidden text-[.65rem] font-extrabold uppercase tracking-[.13em] text-[#315443] sm:inline">Lihat semua karya ↗</a></div><div class="mt-8 grid gap-5 sm:grid-cols-2">{otherProjects.map((project) => <a href={`/portfolio/${project.id}`} class="group"><div class="image-zoom aspect-[16/9] bg-[#ded6c7]"><Image src={project.image} alt={project.data.title} width={800} height={450} loading="lazy" format="webp" class="h-full w-full object-cover" /></div><p class="mt-4 text-[.6rem] font-extrabold uppercase tracking-[.14em] text-[#315443]">{project.data.displayCategory}</p><h3 class="mt-2 font-serif text-3xl font-semibold leading-[.96] tracking-[-.04em] text-[#17231d] group-hover:text-[#315443]">{project.data.title}</h3></a>)}</div></section>
  </article>
</Layout>
