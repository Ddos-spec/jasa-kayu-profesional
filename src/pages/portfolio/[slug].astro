---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

const allPortfolios = await getCollection('portfolio');
export async function getStaticPaths() {
  const portfolios = await getCollection('portfolio');
  return portfolios.map((portfolio) => ({ params: { slug: portfolio.id }, props: { portfolio } }));
}

const { portfolio } = Astro.props;
const { Content } = await render(portfolio);
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/portfolio/**/*.{jpeg,jpg,png,gif,svg,webp}');
const fallbackPaths = ['/src/assets/images/portfolio/portfolio-1.svg', '/src/assets/images/portfolio/portfolio-2.svg', '/src/assets/images/portfolio/portfolio-3.svg'];
const toAssetImagePath = (path?: string, slug?: string) => path?.startsWith('/images/portfolio/') ? `/src/assets${path}` : path || (slug ? `/src/assets/images/portfolio/${slug}.jpg` : undefined);
const resolveImage = async (path?: string, fallback = fallbackPaths[0]) => path && images[path] ? (await images[path]()).default : (await images[fallback]()).default;
const mainImage = await resolveImage(toAssetImagePath(portfolio.data.image, portfolio.id));
const galleryImages = await Promise.all((portfolio.data.gallery ?? []).map(async (path, index) => ({ src: await resolveImage(toAssetImagePath(path), fallbackPaths[index % fallbackPaths.length]), alt: `${portfolio.data.title} — dokumentasi ${index + 2}` })));
const schemaImages = [portfolio.data.image, ...(portfolio.data.gallery ?? [])].filter(Boolean);
const seoTitle = portfolio.data.seoTitle || `${portfolio.data.title} | Portofolio Jasa Kayu Profesional`;
const seoDescription = portfolio.data.seoDescription || portfolio.data.description;
const otherProjects = await Promise.all(allPortfolios.filter((item) => item.id !== portfolio.id).slice(0, 2).map(async (item, index) => ({ ...item, image: await resolveImage(toAssetImagePath(item.data.image, item.id), fallbackPaths[index % fallbackPaths.length]) })));
---
<Layout title={seoTitle} description={seoDescription} canonical={`https://www.jasakayuprofesional.com/portfolio/${portfolio.id}`} image={portfolio.data.image}>
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'CreativeWork', name: portfolio.data.title, description: seoDescription, genre: portfolio.data.category, dateCreated: `${portfolio.data.year ?? new Date().getFullYear()}-01-01`, creator: { '@type': 'Organization', name: 'Jasa Kayu Profesional', url: 'https://www.jasakayuprofesional.com/', telephone: '+6281283135295' }, image: schemaImages, keywords: portfolio.data.keywords })} />

  <article class="bg-[#f4f2eb] pb-28 pt-32 sm:pt-40 lg:pb-40 lg:pt-48">
    <header class="section-shell">
      <div class="grid gap-9 border-b border-[#17231d]/15 pb-10 lg:grid-cols-[.48fr_1.52fr] lg:items-end">
        <div class="reveal"><a href="/galeri" class="section-kicker hover:text-[#17352a]">Kembali ke karya</a><p class="mt-5 text-[.6rem] font-extrabold uppercase tracking-[.15em] text-[#7a837b]">Project dossier / {portfolio.data.year ?? 'Archive'}</p></div>
        <div class="reveal"><p class="text-[.63rem] font-extrabold uppercase tracking-[.15em] text-[#315443]">{portfolio.data.displayCategory} · {portfolio.data.location ?? 'Jabodetabek'}</p><h1 class="display-title text-balance mt-4 max-w-6xl text-6xl text-[#17231d] sm:text-7xl lg:text-[8rem]">{portfolio.data.title}</h1></div>
      </div>
      <div class="mt-7 grid gap-7 lg:grid-cols-[.5fr_1.5fr]">
        <div></div>
        <div class="grid gap-7 sm:grid-cols-[1fr_.7fr] sm:items-end"><p class="max-w-3xl text-base leading-7 text-[#566158] sm:text-lg sm:leading-8">{portfolio.data.description}</p><a href="/#kontak" class="group flex items-center justify-between border-b border-[#17231d]/20 pb-3 text-[.66rem] font-extrabold uppercase tracking-[.13em] text-[#315443]">Punya kebutuhan serupa <span class="text-lg transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true">↗</span></a></div>
      </div>
    </header>

    <div class="section-shell reveal mt-12">
      <div class="image-zoom relative overflow-hidden bg-[#d7c9b3]"><Image src={mainImage} alt={portfolio.data.title} class="aspect-[16/10] w-full object-cover sm:aspect-[16/8]" width={1800} height={1000} loading="eager" fetchpriority="high" format="webp" /><div class="pointer-events-none absolute inset-x-0 bottom-0 flex justify-between gap-4 bg-gradient-to-t from-black/60 to-transparent p-5 pt-24 text-[.58rem] font-extrabold uppercase tracking-[.15em] text-white/70 sm:p-7 sm:pt-28"><span>{portfolio.data.displayCategory}</span><span>{portfolio.data.location ?? 'Jabodetabek'} {portfolio.data.year ? `· ${portfolio.data.year}` : ''}</span></div></div>
    </div>

    <section class="section-shell mt-12 grid gap-12 border-b border-[#17231d]/15 pb-16 lg:grid-cols-[.58fr_1.42fr] lg:pb-24">
      <div class="reveal sticky-copy self-start">
        <p class="section-kicker">Project facts</p>
        <dl class="project-meta-grid mt-6 grid grid-cols-2 text-sm">
          <div class="p-4"><dt class="text-[.57rem] font-extrabold uppercase tracking-[.14em] text-[#7a837b]">Kategori</dt><dd class="mt-2 font-bold text-[#17231d]">{portfolio.data.displayCategory}</dd></div>
          <div class="p-4"><dt class="text-[.57rem] font-extrabold uppercase tracking-[.14em] text-[#7a837b]">Lokasi</dt><dd class="mt-2 font-bold text-[#17231d]">{portfolio.data.location ?? 'Jabodetabek'}</dd></div>
          <div class="p-4"><dt class="text-[.57rem] font-extrabold uppercase tracking-[.14em] text-[#7a837b]">Tahun</dt><dd class="mt-2 font-bold text-[#17231d]">{portfolio.data.year ?? '—'}</dd></div>
          <div class="p-4"><dt class="text-[.57rem] font-extrabold uppercase tracking-[.14em] text-[#7a837b]">Studio</dt><dd class="mt-2 font-bold text-[#17231d]">Jasa Kayu</dd></div>
        </dl>
      </div>
      <div class="reveal"><p class="font-serif text-[clamp(2.6rem,5.2vw,5.5rem)] font-semibold leading-[.92] tracking-[-.05em] text-[#17231d]">Sebuah proyek kayu dinilai dari bagaimana material <em>bertemu ruang</em>, bukan dari seberapa banyak istilah premium yang dipakai.</p><div class="prose mt-12 max-w-[48rem]"><Content /></div></div>
    </section>

    {galleryImages.length > 0 && (
      <section class="section-shell mt-20 lg:mt-28">
        <div class="grid gap-8 border-b border-[#17231d]/15 pb-8 lg:grid-cols-[.6fr_1.4fr] lg:items-end"><p class="reveal section-kicker">Dokumentasi</p><div class="reveal"><h2 class="display-title text-5xl text-[#17231d] sm:text-6xl lg:text-7xl">Melihat keputusan pada <em>detail.</em></h2><p class="mt-5 max-w-xl text-sm leading-7 text-[#59645b]">Sudut lebar memberi konteks. Foto detail memperlihatkan kualitas pertemuan material, finishing, dan proporsi pengerjaan.</p></div></div>
        <div class="mt-10 grid gap-6 lg:grid-cols-12 lg:gap-y-20">
          {galleryImages.map((image, index) => (
            <figure class={`reveal ${index % 3 === 0 ? 'lg:col-span-8' : index % 3 === 1 ? 'lg:col-span-4 lg:pt-24' : 'lg:col-span-7 lg:col-start-4'}`}>
              <div class="image-zoom overflow-hidden bg-[#d7c9b3]"><Image src={image.src} alt={image.alt} width={1300} height={950} loading="lazy" format="webp" class={`w-full object-cover ${index % 3 === 1 ? 'aspect-[3/4]' : 'aspect-[4/3]'}`} /></div>
              <figcaption class="mt-3 flex justify-between border-t border-[#17231d]/15 pt-3 text-[.56rem] font-extrabold uppercase tracking-[.14em] text-[#747d75]"><span>Detail {String(index + 1).padStart(2, '0')}</span><span>{portfolio.data.location ?? 'Jabodetabek'}</span></figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    <section class="section-shell mt-24 lg:mt-36">
      <div class="grid overflow-hidden bg-[#17352a] text-white lg:grid-cols-[1.15fr_.85fr]">
        <div class="p-7 sm:p-10 lg:p-14"><p class="section-kicker text-[#e6c88f]">Punya kondisi serupa?</p><h2 class="mt-6 max-w-3xl font-serif text-[clamp(3rem,6vw,6rem)] font-semibold leading-[.85] tracking-[-.055em]">Bawa foto area.<br /><em>Kita baca konteksnya.</em></h2><p class="mt-7 max-w-xl text-sm leading-7 text-white/65">Ukuran kasar, lokasi, kebutuhan utama, dan referensi visual sudah cukup untuk membuka diskusi awal sebelum survei.</p></div>
        <div class="flex flex-col justify-end border-t border-white/15 p-7 sm:p-10 lg:border-l lg:border-t-0 lg:p-14"><p class="text-[.62rem] font-extrabold uppercase tracking-[.15em] text-white/45">Next step</p><a href="/#kontak" class="group mt-5 flex items-end justify-between border-b border-white/30 pb-4 font-serif text-3xl font-semibold tracking-[-.04em] sm:text-4xl">Kirim brief proyek <span class="transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true">↗</span></a></div>
      </div>
    </section>

    <section class="section-shell mt-24 border-t border-[#17231d]/15 pt-10 lg:mt-36">
      <div class="flex items-end justify-between gap-6"><div><p class="section-kicker">Karya terkait</p><h2 class="mt-4 font-serif text-4xl font-semibold tracking-[-.04em] text-[#17231d] sm:text-5xl">Lanjutkan eksplorasi</h2></div><a href="/galeri" class="hidden text-[.65rem] font-extrabold uppercase tracking-[.13em] text-[#315443] sm:inline">Lihat arsip ↗</a></div>
      <div class="mt-8 grid gap-8 sm:grid-cols-2">{otherProjects.map((project, index) => <a href={`/portfolio/${project.id}`} class={`group ${index === 1 ? 'sm:pt-16' : ''}`}><div class="image-zoom aspect-[16/10] bg-[#ded6c7]"><Image src={project.image} alt={project.data.title} width={1000} height={650} loading="lazy" format="webp" class="h-full w-full object-cover" /></div><p class="mt-4 text-[.6rem] font-extrabold uppercase tracking-[.14em] text-[#315443]">{project.data.displayCategory}</p><h3 class="mt-2 font-serif text-3xl font-semibold leading-[.96] tracking-[-.04em] text-[#17231d] transition group-hover:text-[#315443] sm:text-4xl">{project.data.title}</h3></a>)}</div>
    </section>
  </article>
</Layout>
