---
import { Image } from 'astro:assets';
import DeckUlinLayout from '../layouts/DeckUlinLayout.astro';
import heroImage from '../assets/images/portfolio/deck-ulin-rancamaya-bogor/deck-ulin-rancamaya-bogor-1.jpg';
import detailImage from '../assets/images/portfolio/deck-ulin-rancamaya-bogor/deck-ulin-rancamaya-bogor-2.jpg';
import apartmentDeck from '../assets/images/portfolio/deck-apartemen-dharmawangsa.webp';
import cafeDeck2 from '../assets/images/portfolio/decking-bengkirai-cafe-artisan-jakarta/decking-bengkirai-cafe-artisan-jakarta-2.jpg';
import cafeDeck4 from '../assets/images/portfolio/decking-bengkirai-cafe-artisan-jakarta/decking-bengkirai-cafe-artisan-jakarta-4.jpg';

const whatsappHref = 'https://wa.me/6281283135295?text=Halo%20Jasa%20Kayu%20Profesional%2C%20saya%20ingin%20konsultasi%20deck%20ulin.';

const faqs = [
  ['Apakah kayu ulin cocok untuk area outdoor yang terkena hujan?', 'Ulin sering digunakan untuk area outdoor karena kayunya padat dan tahan terhadap kondisi luar. Hasil pemasangan tetap bergantung pada rangka bawah, jalur air, ventilasi, jarak antar papan, dan sistem pengikat.'],
  ['Apa yang perlu dikirim untuk estimasi awal?', 'Kirim foto area dari beberapa sudut, ukuran kasar, lokasi proyek, kondisi permukaan saat ini, dan informasi apakah area terkena hujan langsung atau semi outdoor.'],
  ['Apakah deck perlu dibuat miring?', 'Area outdoor perlu memiliki arah aliran air yang jelas. Kemiringan permukaan, posisi drain, elevasi pintu, dan struktur bawah diperiksa sebelum arah papan ditentukan.'],
  ['Apakah warna kayu ulin akan berubah?', 'Warna kayu outdoor dapat berubah karena matahari, hujan, dan pemakaian. Finishing dan jadwal perawatan disesuaikan dengan lokasi serta tampilan yang diinginkan.'],
  ['Bisa dipasang di balkon, rooftop, atau area dekat kolam?', 'Bisa, tetapi detail pemasangannya perlu disesuaikan dengan kondisi slab, tinggi pintu, drainase, akses perawatan, dan risiko genangan di area tersebut.'],
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Jasa Decking Kayu Ulin',
      serviceType: 'Perencanaan dan pemasangan decking kayu ulin',
      url: 'https://deckulin.jasakayuprofesional.com/',
      provider: {
        '@type': 'Organization',
        name: 'Jasa Kayu Profesional',
        url: 'https://www.jasakayuprofesional.com/',
      },
      areaServed: ['Jakarta', 'Bogor', 'Depok', 'Tangerang', 'Tangerang Selatan', 'Bekasi'].map((name) => ({
        '@type': 'AdministrativeArea',
        name,
      })),
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(([question, answer]) => ({
        '@type': 'Question',
        name: question,
        acceptedAnswer: { '@type': 'Answer', text: answer },
      })),
    },
  ],
};
---

<DeckUlinLayout>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <section id="hero" class="relative min-h-[50rem] overflow-hidden bg-[#121a15] text-white lg:min-h-screen">
    <Image src={heroImage} alt="Deck kayu ulin Rancamaya Bogor" width={1800} height={1200} loading="eager" fetchpriority="high" format="webp" class="absolute inset-0 h-full w-full object-cover opacity-75" />
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(10,17,13,.94)_0%,rgba(10,17,13,.72)_48%,rgba(10,17,13,.24)_100%)]"></div>
    <div class="grid-lines absolute inset-0 opacity-20"></div>
    <div class="section-shell relative flex min-h-[50rem] flex-col justify-end pb-10 pt-32 lg:min-h-screen lg:pb-16">
      <p class="section-kicker text-[#e6c88f]">Jasa Deck Ulin · Jabodetabek</p>
      <h1 class="display-title mt-6 max-w-6xl text-[clamp(3.4rem,10vw,9rem)] text-white">Spesialis pemasangan<br /><em>deck kayu ulin.</em></h1>
      <div class="mt-8 grid gap-7 border-t border-white/20 pt-6 lg:grid-cols-[1.2fr_.8fr] lg:items-end">
        <p class="max-w-2xl text-base leading-7 text-white/72 sm:text-lg sm:leading-8">Pemasangan deck kayu ulin untuk balkon, taman, rooftop, pool deck, villa, dan area outdoor. Pekerjaan dimulai dari pengecekan kondisi lokasi, rangka bawah, drainase, sampai finishing.</p>
        <div class="flex flex-col gap-3 sm:flex-row lg:justify-end">
          <a href="#dokumentasi" class="btn-ghost !border-white/30 !text-white hover:!bg-white hover:!text-[#17231d]">Lihat dokumentasi</a>
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn-wood !bg-[#e6c88f] !text-[#17231d] hover:!bg-white">Konsultasi via WhatsApp ↗</a>
        </div>
      </div>
      <div class="mt-10 grid gap-px border border-white/15 bg-white/15 sm:grid-cols-2 lg:grid-cols-4">
        {[
          ['Material', 'Kayu ulin'],
          ['Pekerjaan', 'Deck outdoor'],
          ['Cakupan', 'Rangka sampai finishing'],
          ['Area', 'Jabodetabek'],
        ].map(([label, value]) => (
          <div class="bg-[#152018]/72 p-4 backdrop-blur-sm">
            <p class="text-[.55rem] font-extrabold uppercase tracking-[.15em] text-white/42">{label}</p>
            <p class="mt-2 text-sm font-bold text-white/92">{value}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="material" class="bg-[#f3f0e7] py-24 sm:py-32 lg:py-40">
    <div class="section-shell grid gap-12 lg:grid-cols-[.52fr_1.48fr]">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="section-kicker">Material & pemasangan</p>
        <p class="mt-6 max-w-xs text-sm leading-7 text-[#667068]">Kayu ulin cocok untuk penggunaan outdoor, tetapi hasil akhirnya tetap ditentukan oleh kondisi dasar, rangka bawah, jalur air, gap papan, dan finishing.</p>
      </div>
      <div>
        <h2 class="display-title text-5xl sm:text-6xl lg:text-8xl">Deck ulin bukan cuma soal <em>pilih kayu.</em></h2>
        <div class="mt-10 grid gap-px border border-[#17231d]/15 bg-[#17231d]/15 sm:grid-cols-2">
          {[
            ['Rangka bawah', 'Jarak tumpuan, elevasi, dan kondisi struktur diperiksa sebelum papan dipasang.'],
            ['Drainase', 'Slope, posisi drain, arah aliran air, dan tinggi pintu perlu jelas sejak awal.'],
            ['Jarak papan', 'Gap antar papan membantu air turun dan memberi ruang saat kayu berubah dimensi.'],
            ['Finishing', 'Jenis finishing disesuaikan dengan paparan matahari, hujan, dan intensitas pemakaian.'],
          ].map(([heading, text], index) => (
            <article class="bg-[#fffdf7] p-7 sm:p-9">
              <p class="text-[.58rem] font-extrabold uppercase tracking-[.15em] text-[#315443]">0{index + 1}</p>
              <h3 class="mt-6 font-serif text-4xl font-semibold tracking-[-.045em]">{heading}</h3>
              <p class="mt-5 text-sm leading-7 text-[#59645b]">{text}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="dokumentasi" class="bg-[#151d18] py-24 text-white sm:py-32 lg:py-40">
    <div class="section-shell">
      <div class="grid gap-8 border-b border-white/15 pb-10 lg:grid-cols-[.5fr_1.5fr] lg:items-end">
        <div>
          <p class="section-kicker text-[#e6c88f]">Dokumentasi pekerjaan</p>
          <p class="mt-6 max-w-sm text-sm leading-7 text-white/52">Dua foto pertama berasal dari proyek Deck Ulin Rancamaya. Foto berikutnya adalah dokumentasi proyek decking outdoor lain untuk menunjukkan detail pengerjaan; jenis kayunya dapat berbeda.</p>
        </div>
        <h2 class="display-title text-5xl sm:text-6xl lg:text-8xl">Foto proyek dan<br /><em>detail pengerjaan.</em></h2>
      </div>

      <div class="mt-8 grid gap-4 lg:grid-cols-12">
        <figure class="overflow-hidden bg-white/5 lg:col-span-7">
          <Image data-deck-image src={heroImage} alt="Deck kayu ulin Rancamaya Bogor" width={1400} height={900} loading="lazy" format="webp" class="aspect-[4/3] w-full object-cover sm:aspect-[16/10]" />
          <figcaption class="flex items-center justify-between gap-4 border-t border-white/10 px-5 py-4 text-[.58rem] font-extrabold uppercase tracking-[.13em] text-white/48"><span>Deck Ulin Rancamaya · overview</span><span>01</span></figcaption>
        </figure>

        <figure class="overflow-hidden bg-white/5 lg:col-span-5">
          <Image data-deck-image src={detailImage} alt="Detail papan deck kayu ulin Rancamaya Bogor" width={1000} height={1200} loading="lazy" format="webp" class="aspect-[4/3] w-full object-cover sm:aspect-[16/10] lg:aspect-[5/6]" />
          <figcaption class="flex items-center justify-between gap-4 border-t border-white/10 px-5 py-4 text-[.58rem] font-extrabold uppercase tracking-[.13em] text-white/48"><span>Deck Ulin Rancamaya · detail papan</span><span>02</span></figcaption>
        </figure>

        <figure class="overflow-hidden bg-white/5 lg:col-span-4">
          <Image data-deck-image src={apartmentDeck} alt="Referensi deck outdoor pada balkon apartemen" width={900} height={1100} loading="lazy" format="webp" class="aspect-[4/5] w-full object-cover" />
          <figcaption class="px-5 py-4 text-[.58rem] font-extrabold uppercase tracking-[.13em] text-white/48">Referensi deck outdoor · balkon apartemen</figcaption>
        </figure>

        <figure class="overflow-hidden bg-white/5 lg:col-span-4">
          <Image data-deck-image src={cafeDeck2} alt="Referensi detail pemasangan decking outdoor" width={900} height={1100} loading="lazy" format="webp" class="aspect-[4/5] w-full object-cover" />
          <figcaption class="px-5 py-4 text-[.58rem] font-extrabold uppercase tracking-[.13em] text-white/48">Referensi deck outdoor · detail pemasangan</figcaption>
        </figure>

        <figure class="overflow-hidden bg-white/5 lg:col-span-4">
          <Image data-deck-image src={cafeDeck4} alt="Referensi hasil akhir decking outdoor" width={900} height={1100} loading="lazy" format="webp" class="aspect-[4/5] w-full object-cover" />
          <figcaption class="px-5 py-4 text-[.58rem] font-extrabold uppercase tracking-[.13em] text-white/48">Referensi deck outdoor · hasil akhir</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section id="proyek" class="overflow-hidden bg-[#e1d6c3] py-24 sm:py-32 lg:py-40">
    <div class="section-shell grid gap-12 lg:grid-cols-[1.05fr_.95fr] lg:items-center">
      <div class="overflow-hidden bg-[#cfc0a8]">
        <Image src={detailImage} alt="Detail deck kayu ulin Rancamaya Bogor" width={1400} height={1100} loading="lazy" format="webp" class="aspect-[4/3] w-full object-cover lg:aspect-[4/5]" />
      </div>
      <div class="lg:pl-6">
        <p class="section-kicker">Proyek Rancamaya</p>
        <p class="mt-6 text-[.6rem] font-extrabold uppercase tracking-[.15em] text-[#727b73]">Rancamaya · Bogor</p>
        <h2 class="display-title mt-4 text-5xl sm:text-6xl lg:text-8xl">Contoh pekerjaan <em>deck kayu ulin.</em></h2>
        <p class="mt-7 max-w-xl text-sm leading-7 text-[#59645b]">Halaman proyek berisi dokumentasi yang lebih lengkap untuk melihat detail papan, tepi, sambungan, dan hasil pemasangan.</p>
        <a href="https://www.jasakayuprofesional.com/portfolio/deck-ulin-rancamaya-bogor" class="group mt-8 flex max-w-sm items-center justify-between border-b border-[#17231d]/20 pb-3 text-[.66rem] font-extrabold uppercase tracking-[.13em] text-[#315443]">Lihat detail proyek <span class="text-xl transition-transform group-hover:translate-x-1 group-hover:-translate-y-1">↗</span></a>
      </div>
    </div>
  </section>

  <section class="bg-[#f3f0e7] py-24 sm:py-32 lg:py-40">
    <div class="section-shell grid gap-10 lg:grid-cols-[.95fr_1.05fr] lg:items-center">
      <div class="order-2 lg:order-1">
        <p class="section-kicker">Drainase outdoor</p>
        <h2 class="display-title mt-6 text-5xl sm:text-6xl lg:text-8xl">Deck outdoor harus siap <em>terkena hujan.</em></h2>
        <p class="mt-7 max-w-xl text-sm leading-7 text-[#59645b]">Slope, gap antar papan, posisi drain, dan ventilasi bawah diperiksa supaya air tidak tertahan di bawah deck.</p>
        <div class="mt-8 grid gap-4 sm:grid-cols-3">
          {[
            ['Slope', 'Arah aliran air dibuat jelas menuju titik pembuangan.'],
            ['Gap', 'Jarak antar papan membantu air turun dan memberi ruang perubahan dimensi kayu.'],
            ['Akses', 'Bagian tertentu tetap perlu bisa diperiksa dan dirawat.'],
          ].map(([heading, text]) => (
            <div class="border-t border-[#17231d]/20 pt-4">
              <p class="font-serif text-2xl font-semibold">{heading}</p>
              <p class="mt-2 text-xs leading-6 text-[#667068]">{text}</p>
            </div>
          ))}
        </div>
      </div>
      <figure class="order-1 overflow-hidden bg-[#d7cbb8] lg:order-2">
        <Image data-deck-image src={heroImage} alt="Deck kayu ulin pada area outdoor" width={1000} height={1200} loading="lazy" format="webp" class="aspect-[4/3] w-full object-cover lg:aspect-[4/5]" />
        <figcaption class="px-5 py-4 text-[.55rem] font-extrabold uppercase tracking-[.13em] text-[#677168]">Deck Ulin Rancamaya · area outdoor</figcaption>
      </figure>
    </div>
  </section>

  <section id="sistem" class="bg-[#101712] py-24 text-white sm:py-32 lg:py-40">
    <div class="section-shell">
      <div class="grid gap-10 border-b border-white/15 pb-10 lg:grid-cols-[.52fr_1.48fr] lg:items-end">
        <p class="section-kicker text-[#e6c88f]">Urutan pekerjaan</p>
        <h2 class="display-title text-5xl sm:text-6xl lg:text-8xl">Pemasangan dimulai dari kondisi lokasi,<br /><em>bukan langsung pasang papan.</em></h2>
      </div>
      <div class="mt-4">
        {[
          ['01', 'Survey lokasi', 'Periksa slope, drain, elevasi, akses, permukaan existing, struktur, dan pertemuan dengan pintu atau dinding.'],
          ['02', 'Tentukan layout', 'Tentukan arah papan, panjang modul, gap, border, sambungan, jarak rangka, dan detail tepi.'],
          ['03', 'Pasang rangka bawah', 'Atur joist, spacer, elevasi, dan titik tumpu sambil mempertahankan jalur air serta ventilasi.'],
          ['04', 'Pasang papan & finishing', 'Pasang papan, cek alignment dan gap, rapikan tepi, lalu lakukan finishing sesuai kebutuhan area.'],
        ].map(([number, heading, text]) => (
          <div class="grid gap-4 border-b border-white/15 py-7 sm:grid-cols-[4rem_.7fr_1.3fr]">
            <span class="text-[.6rem] font-extrabold uppercase tracking-[.15em] text-[#e6c88f]">{number}</span>
            <h3 class="font-serif text-3xl font-semibold tracking-[-.04em] sm:text-4xl">{heading}</h3>
            <p class="max-w-2xl text-sm leading-7 text-white/58">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="faq" class="bg-[#fffdf7] py-24 sm:py-32">
    <div class="section-shell max-w-5xl">
      <div class="grid gap-8 border-b border-[#17231d]/15 pb-8 sm:grid-cols-[.45fr_1.55fr] sm:items-end">
        <p class="section-kicker">FAQ</p>
        <h2 class="display-title text-5xl sm:text-6xl">Pertanyaan tentang <em>deck kayu ulin.</em></h2>
      </div>
      <div class="divide-y divide-[#17231d]/15 border-b border-[#17231d]/15">
        {faqs.map(([question, answer]) => (
          <details class="group py-6">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-5 font-serif text-2xl font-semibold tracking-[-.03em] sm:text-3xl">
              <span>{question}</span>
              <span class="text-3xl font-normal text-[#315443] transition group-open:rotate-45">+</span>
            </summary>
            <p class="mt-4 max-w-2xl text-sm leading-7 text-[#59645b]">{answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[#8b613a] py-20 text-white sm:py-28">
    <div class="section-shell grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
      <div>
        <p class="text-[.62rem] font-extrabold uppercase tracking-[.15em] text-white/55">Konsultasi awal</p>
        <h2 class="display-title mt-5 max-w-5xl text-5xl sm:text-6xl lg:text-8xl">Kirim foto area dan ukuran kasar.<br /><em>Kami cek kebutuhan pemasangannya.</em></h2>
        <p class="mt-6 max-w-2xl text-sm leading-7 text-white/70">Sertakan lokasi proyek dan kondisi area. Dari situ kami bisa memberi arahan awal sebelum survey atau estimasi lebih lanjut.</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
        <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn-wood !bg-white !text-[#17231d]">WhatsApp ↗</a>
        <a href="mailto:alimruswandi@gmail.com" class="btn-ghost !border-white/35 !text-white hover:!bg-white hover:!text-[#17231d]">Email ↗</a>
      </div>
    </div>
  </section>
</DeckUlinLayout>