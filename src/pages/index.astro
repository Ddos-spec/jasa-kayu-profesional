---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import ServiceAreas from '../components/ServiceAreas.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import Portfolio from '../components/Portfolio.astro';
import Testimonials from '../components/Testimonials.astro';
import JournalPreview from '../components/JournalPreview.astro';
import FAQSection from '../components/FAQSection.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import SchemaMarkup from '../components/common/SchemaMarkup.astro';
---
<Layout title="Jasa Kayu Profesional | Studio Kayu untuk Ruang yang Bertahan Lama" description="Studio pengerjaan kayu untuk lantai, decking, tangga, ceiling, wall panel, dan detail custom di Jabodetabek. Mulai konsultasi dari foto area dan kebutuhan proyek Anda." canonical="https://www.jasakayuprofesional.com/" image="/images/portfolio/deck-ulin-rancamaya-bogor/deck-ulin-rancamaya-bogor-1.jpg">
  <SchemaMarkup
    type="Organization"
    name="Jasa Kayu Profesional"
    url="https://www.jasakayuprofesional.com/"
    description="Jasa kayu profesional untuk lantai kayu, decking, tangga, ceiling, wall panel, dan pekerjaan custom di Jabodetabek."
    logo="/icons/wmremove-transformed.png"
  />
  <SchemaMarkup
    type="LocalBusiness"
    name="Jasa Kayu Profesional"
    url="https://www.jasakayuprofesional.com/"
    description="Jasa kayu profesional untuk lantai kayu, decking, tangga, ceiling, wall panel, dan pekerjaan custom di Jabodetabek."
    logo="/icons/wmremove-transformed.png"
  />
  <Hero />
  <Services />
  <ServiceAreas />
  <WhyChooseUs />
  <Portfolio />
  <Testimonials />
  <JournalPreview />
  <FAQSection />
  <Contact />
  <Footer slot="footer" />
</Layout>
