---
import Layout from '../../layouts/Layout.astro';
import ServiceEditorial from '../../components/ServiceEditorial.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import heroImage from '../../assets/images/portfolio/townhouse-jakarta-wall-panel-walnut.jpg';
import detailImage from '../../assets/images/portfolio/art-installation-parametric-wall.jpg';

const title = 'Jasa Wall Panel & Dinding Kayu Jabodetabek | Jasa Kayu Profesional';
const description = 'Perencanaan dan pemasangan wall panel, kisi-kisi, feature wall, serta wall cladding kayu di Jabodetabek dengan perhatian pada modul, sambungan, pencahayaan, dan kondisi dinding.';
const canonical = 'https://www.jasakayuprofesional.com/layanan/dinding-kayu-dan-wall-cladding';
const serviceSchema = {
  '@context': 'https://schema.org', '@type': 'Service', name: 'Jasa Wall Panel dan Dinding Kayu', serviceType: 'Pemasangan wall panel dan wall cladding kayu', description,
  provider: { '@type': 'Organization', name: 'Jasa Kayu Profesional', url: 'https://www.jasakayuprofesional.com/' },
  areaServed: ['Jakarta','Bogor','Depok','Tangerang','Bekasi'].map((name) => ({ '@type': 'AdministrativeArea', name })), url: canonical,
};
---
<Layout title={title} description={description} canonical={canonical} image="/images/portfolio/townhouse-jakarta-wall-panel-walnut.jpg">
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <ServiceEditorial
    kicker="Wall system · Interior"
    title="Dinding kayu yang memberi ritme, bukan kebisingan visual."
    intro="Wall panel yang baik tidak sekadar menutup dinding. Modul, bayangan, arah serat, sambungan sudut, bukaan, stop kontak, dan pencahayaan harus terbaca sebagai satu komposisi."
    heroImage={heroImage}
    heroAlt="Wall panel kayu pada interior townhouse"
    secondaryImage={detailImage}
    secondaryAlt="Instalasi dinding kayu parametrik"
    facts={[
      { label: 'Format', value: 'Panel / Slat / Cladding' },
      { label: 'Konteks', value: 'Residential / Commercial' },
      { label: 'Detail', value: 'Corner / Lighting / Opening' },
      { label: 'Area', value: 'Jabodetabek' },
    ]}
    statement="Bidang kayu paling kuat ketika proporsinya terasa, tetapi konstruksinya tidak meminta perhatian."
    principles={[
      { title: 'Modul & proporsi', text: 'Lebar panel, jarak slat, garis horizontal atau vertikal, serta titik berhenti harus dibaca terhadap dimensi ruang dan furnitur.' },
      { title: 'Substrate', text: 'Kondisi dinding dasar, kebutuhan rangka, toleransi kerataan, jalur kabel, dan potensi kelembapan menentukan sistem belakang panel.' },
      { title: 'Sudut & bukaan', text: 'Pertemuan di sudut, pintu, jendela, skirting, ceiling, saklar, dan built-in adalah tempat kualitas pengerjaan paling mudah terbaca.' },
      { title: 'Light interaction', text: 'Garis bayangan dan sumber cahaya dapat memperkuat tekstur kayu, tetapi juga bisa menonjolkan ketidakrataan jika detail tidak direncanakan.' },
    ]}
    materials={[
      { name: 'Sungkai', note: 'Tone relatif terang dengan serat yang aktif; cocok untuk ruang yang membutuhkan tekstur tanpa terasa terlalu gelap.' },
      { name: 'Jati', note: 'Karakter hangat dan kuat secara visual. Perlu dikontrol lewat modul dan finishing agar bidang tetap terasa arsitektural.' },
      { name: 'Walnut / dark tone', note: 'Pilihan tone gelap untuk komposisi yang lebih dalam. Pencahayaan dan proporsi bidang menjadi penting supaya ruang tidak terasa berat.' },
    ]}
    process={[
      { title: 'Mapping bidang', text: 'Ukur dinding, bukaan, level, titik listrik, built-in, dan garis ceiling untuk menentukan modul yang realistis.' },
      { title: 'Sample & layout', text: 'Arah serat, jarak, profil, warna finishing, serta garis awal-akhir diuji sebelum produksi penuh.' },
      { title: 'Substructure', text: 'Rangka atau sistem mounting disiapkan sesuai kondisi dinding, kebutuhan service access, serta toleransi kerataan.' },
      { title: 'Install & tune', text: 'Panel dipasang sambil mengontrol garis, reveal, sudut, joint, dan pertemuan dengan elemen arsitektur lain.' },
    ]}
  >
    <section class="bg-[#fffdf7] py-24 sm:py-32 lg:py-40">
      <div class="section-shell grid gap-10 lg:grid-cols-[.55fr_1.45fr]">
        <div class="reveal sticky-copy self-start"><p class="section-kicker">Three languages</p><p class="mt-6 max-w-xs text-sm leading-7 text-[#68736a]">Satu material bisa menghasilkan karakter yang sangat berbeda tergantung profil, modul, dan bagaimana cahaya bergerak di permukaannya.</p></div>
        <div class="reveal-stagger grid gap-px border border-[#17231d]/15 bg-[#17231d]/15 sm:grid-cols-3">
          {[['01','Flat panel','Bidang tenang dengan fokus pada arah serat, joint, dan komposisi besar.'],['02','Slatted','Ritme garis dan bayangan yang lebih kuat, cocok ketika kedalaman visual memang dibutuhkan.'],['03','Sculptural','Modul atau relief tiga dimensi untuk area focal point yang membutuhkan karakter lebih ekspresif.']].map(([n,h,t]) => <div class="bg-[#fffdf7] p-7"><p class="text-[.58rem] font-extrabold uppercase tracking-[.15em] text-[#315443]">{n}</p><h2 class="mt-6 font-serif text-4xl font-semibold leading-[.92] tracking-[-.045em] text-[#17231d]">{h}</h2><p class="mt-5 text-sm leading-7 text-[#59645b]">{t}</p></div>)}
        </div>
      </div>
    </section>
  </ServiceEditorial>
  <Contact />
  <Footer slot="footer" />
</Layout>
