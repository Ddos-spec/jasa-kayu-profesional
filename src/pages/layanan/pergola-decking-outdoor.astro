---
import Layout from '../../layouts/Layout.astro';
import ServiceEditorial from '../../components/ServiceEditorial.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import heroImage from '../../assets/images/portfolio/deck-ulin-rancamaya-bogor/deck-ulin-rancamaya-bogor-1.jpg';
import detailImage from '../../assets/images/portfolio/decking-bengkirai-cafe-artisan-jakarta/decking-bengkirai-cafe-artisan-jakarta-1.jpg';

const title = 'Jasa Decking Kayu & Pergola Outdoor Jabodetabek | Jasa Kayu Profesional';
const description = 'Perencanaan dan pemasangan decking kayu serta pergola outdoor di Jabodetabek. Material, drainase, substructure, fixing, ventilasi, dan finishing dibaca sebagai satu sistem untuk cuaca tropis.';
const canonical = 'https://www.jasakayuprofesional.com/layanan/pergola-decking-outdoor';
const serviceSchema = {
  '@context': 'https://schema.org', '@type': 'Service', name: 'Jasa Decking Kayu dan Pergola Outdoor', serviceType: 'Pemasangan decking dan pergola kayu', description,
  provider: { '@type': 'Organization', name: 'Jasa Kayu Profesional', url: 'https://www.jasakayuprofesional.com/' },
  areaServed: ['Jakarta','Bogor','Depok','Tangerang','Bekasi'].map((name) => ({ '@type': 'AdministrativeArea', name })), url: canonical,
};
---
<Layout title={title} description={description} canonical={canonical} image="/images/portfolio/deck-ulin-rancamaya-bogor/deck-ulin-rancamaya-bogor-1.jpg">
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <ServiceEditorial
    kicker="Outdoor architecture"
    title="Kayu di luar ruang harus siap menghadapi cuaca, bukan hanya kamera."
    intro="Decking dan pergola bekerja di bawah panas, hujan, kelembapan, genangan, serta perubahan temperatur. Karena itu jarak antar papan, arah drainase, sirkulasi bawah, struktur, dan sistem fixing sama pentingnya dengan pilihan kayu."
    heroImage={heroImage}
    heroAlt="Decking kayu Ulin pada area outdoor hunian"
    secondaryImage={detailImage}
    secondaryAlt="Decking kayu Bengkirai pada area komersial"
    facts={[
      { label: 'Application', value: 'Decking / Pergola' },
      { label: 'Exposure', value: 'Sun / Rain / Humidity' },
      { label: 'Material', value: 'Ulin / Bengkirai / sesuai konteks' },
      { label: 'Area', value: 'Jabodetabek' },
    ]}
    statement="Outdoor timber berhasil ketika air punya jalan keluar dan material punya ruang untuk bergerak."
    principles={[
      { title: 'Drainage first', text: 'Arah air, kemiringan, titik buang, serta jarak terhadap permukaan bawah harus dibaca sebelum pola decking ditentukan.' },
      { title: 'Ventilasi bawah', text: 'Ruang sirkulasi membantu area bawah mengering dan mengurangi kondisi lembap yang terus-menerus menahan kayu.' },
      { title: 'Fixing system', text: 'Sekrup, hidden fixing, jarak joist, dan titik sambungan harus disesuaikan dengan dimensi papan dan kondisi struktur.' },
      { title: 'Weathering', text: 'Warna kayu outdoor akan berubah. Finishing dan maintenance perlu dipilih berdasarkan tampilan aging yang memang diinginkan.' },
    ]}
    materials={[
      { name: 'Ulin', note: 'Material dengan karakter sangat padat dan kuat untuk aplikasi outdoor; detail pemasangan tetap harus memberi perhatian pada ventilasi dan pergerakan papan.' },
      { name: 'Bengkirai', note: 'Opsi outdoor dengan karakter serat dan tone hangat. Seleksi material, kadar air, serta finishing perlu disesuaikan dengan tingkat eksposur.' },
      { name: 'Supporting structure', note: 'Bukan hanya papan permukaan. Joist, dudukan, spacer, fixing, dan pertemuan dengan beton atau baja menentukan performa sistem.' },
    ]}
    planningChecks={[
      { title: 'Water path', text: 'Kami baca arah slope, posisi drain, area yang rawan menahan air, elevasi pintu, pertemuan dengan taman, serta kemungkinan air datang dari bidang lain.' },
      { title: 'Base & clearance', text: 'Jarak antara decking dan slab/tanah, tinggi joist, ventilasi bawah, serta ruang untuk inspeksi perlu cukup sejak awal.' },
      { title: 'Board module', text: 'Lebar papan, panjang, arah pemasangan, sambungan, border, dan titik potong ditentukan terhadap geometri area supaya pola tidak pecah di ujung.' },
      { title: 'Metal interface', text: 'Pertemuan dengan baja, railing, planter, pintu, kaca, atau facade perlu diselesaikan tanpa memerangkap air dan tanpa membuat kayu sulit diganti saat maintenance.' },
    ]}
    process={[
      { title: 'Read the water', text: 'Cek kemiringan, drain, titik rawan genangan, arah limpasan, elevasi pintu, dan kondisi struktur eksisting.' },
      { title: 'Set the module', text: 'Dimensi papan, arah layout, jarak joist, gap, border detail, serta pola sambungan ditentukan sebelum pemasangan.' },
      { title: 'Build the base', text: 'Substructure disiapkan dengan elevasi dan spacing yang konsisten agar permukaan akhir stabil sekaligus tetap memiliki sirkulasi.' },
      { title: 'Install & weatherproof', text: 'Papan dipasang dengan gap dan fixing terkontrol, lalu finishing serta detail tepi diselesaikan sesuai tingkat eksposur.' },
    ]}
    estimateFactors={[
      { title: 'Jenis kayu & ukuran papan', text: 'Species, dimensi, panjang efektif, sorting, serta kebutuhan cadangan untuk potongan akan memengaruhi material dan ritme instalasi.' },
      { title: 'Kondisi struktur bawah', text: 'Slab rata, existing frame, elevated deck, area taman, atau kebutuhan rangka baru menghasilkan scope substructure yang berbeda.' },
      { title: 'Geometri & detail', text: 'Kurva, planter, kolom, hatch, border, step, trapdoor, railing, serta pola diagonal membutuhkan lebih banyak kontrol dan potongan.' },
      { title: 'Akses & finishing', text: 'Akses material, ketinggian kerja, jam kerja gedung, sistem coating, dan jumlah tahap finishing ikut membentuk kebutuhan tenaga serta waktu.' },
    ]}
    aftercare={[
      { title: 'Keep drainage open', text: 'Daun, tanah, dan kotoran yang menutup gap atau drain perlu dibersihkan agar area bawah tetap dapat mengering.' },
      { title: 'Watch water traps', text: 'Pot, karpet outdoor, furnitur, atau benda yang menempel lama pada permukaan dapat membuat area tertentu selalu lembap dan menua berbeda.' },
      { title: 'Accept weathering', text: 'Outdoor timber akan berubah tone. Pilihan perawatan ditentukan apakah targetnya mempertahankan warna awal atau menerima patina yang lebih natural.' },
      { title: 'Inspect fixing', text: 'Pada area dengan traffic tinggi atau paparan berat, sambungan, board edge, dan fixing sebaiknya diperiksa berkala sebelum masalah kecil menjadi kerusakan luas.' },
    ]}
    faqs={[
      { question: 'Ulin atau Bengkirai untuk decking?', answer: 'Keduanya bisa relevan, tetapi keputusan sebaiknya mempertimbangkan eksposur, dimensi papan, supply, target tone, sistem fixing, dan maintenance. Material tidak bekerja sendirian tanpa substructure yang benar.' },
      { question: 'Apakah decking boleh langsung di atas beton?', answer: 'Tidak selalu langsung. Biasanya perlu detail yang memberi elevasi, jalur air, sirkulasi, dan titik fixing yang stabil. Kondisi slab dan elevasi pintu harus diperiksa lebih dulu.' },
      { question: 'Bisa pakai hidden fixing?', answer: 'Bisa pada sistem dan profil tertentu. Pilihan hidden fixing harus cocok dengan jenis papan, dimensi, movement, dan kebutuhan penggantian papan di kemudian hari.' },
      { question: 'Apa yang perlu dikirim untuk estimasi?', answer: 'Foto area, ukuran kasar, lokasi, kondisi permukaan bawah, posisi drain/pintu, dan referensi desain sudah cukup untuk diskusi awal. Detail final mengikuti survei atau gambar teknis.' },
    ]}
  >
    <section class="bg-[#fffdf7] py-24 sm:py-32 lg:py-40">
      <div class="section-shell">
        <div class="grid gap-10 border-b border-[#17231d]/15 pb-10 lg:grid-cols-[.52fr_1.48fr] lg:items-end"><p class="reveal section-kicker">Weather logic</p><div class="reveal"><h2 class="display-title text-5xl text-[#17231d] sm:text-6xl lg:text-8xl">Decking bukan lantai indoor yang dipindahkan <em>ke luar.</em></h2><p class="mt-6 max-w-2xl text-sm leading-7 text-[#59645b]">Sistem outdoor harus memberi jalur bagi air, udara, ekspansi, dan pekerjaan maintenance. Yang terlihat hanya papan atas; performanya ditentukan lapisan di bawahnya.</p></div></div>
        <div class="reveal-stagger mt-10 grid gap-px border border-[#17231d]/15 bg-[#17231d]/15 sm:grid-cols-2 lg:grid-cols-4">
          {[['01','Surface','Papan, tekstur, grip, gap, arah serat.'],['02','Fixing','Sekrup atau concealed system sesuai material.'],['03','Substructure','Joist, spacer, elevasi, dan titik tumpu.'],['04','Water path','Slope, drain, ventilasi, akses maintenance.']].map(([n,h,t]) => <div class="bg-[#fffdf7] p-7"><p class="text-[.58rem] font-extrabold uppercase tracking-[.15em] text-[#315443]">{n}</p><h3 class="mt-6 font-serif text-4xl font-semibold leading-[.92] tracking-[-.045em] text-[#17231d]">{h}</h3><p class="mt-5 text-sm leading-7 text-[#59645b]">{t}</p></div>)}
        </div>
      </div>
    </section>
  </ServiceEditorial>
  <Contact />
  <Footer slot="footer" />
</Layout>
