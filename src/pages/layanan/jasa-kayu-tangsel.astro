---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import dharmawangsa from '../../assets/images/portfolio/deck-apartemen-dharmawangsa.webp';
import deckingUlin from '../../assets/images/portfolio/deck-ulin-rancamaya-bogor/deck-ulin-rancamaya-bogor-1.jpg';

const title = 'Jasa Kayu Tangerang Selatan & BSD | Decking, Lantai, Tangga';
const description = 'Jasa kayu profesional untuk Tangerang Selatan, BSD, Bintaro, Serpong, Pamulang, Ciputat, dan Pondok Aren. Konsultasi, survei, produksi, dan pemasangan lantai kayu, decking, tangga, serta detail custom.';
const canonical = 'https://www.jasakayuprofesional.com/layanan/jasa-kayu-tangsel';
const faqs = [
  ['Apakah melayani seluruh Tangerang Selatan?', 'Ya. Kami melayani BSD dan Serpong, Bintaro dan Pondok Aren, Ciputat, Pamulang, Setu, serta area Tangerang Selatan lain sesuai jadwal survei dan kompleksitas proyek.'],
  ['Bisa survei untuk apartemen atau cluster?', 'Bisa. Untuk hunian vertikal atau cluster, kami bantu membaca akses material, jam kerja, kondisi bidang, dan aturan pengelola sebelum scope ditetapkan.'],
  ['Apa yang perlu disiapkan sebelum konsultasi?', 'Kirim foto area dari beberapa sudut, ukuran kasar panjang dan lebar, lokasi, referensi visual, serta kebutuhan utama. Dari sana kami arahkan opsi material dan langkah berikutnya.'],
];
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Service', name: 'Jasa Kayu Tangerang Selatan dan BSD', serviceType: 'Pengerjaan kayu custom', description, provider: { '@type': 'Organization', name: 'Jasa Kayu Profesional', url: 'https://www.jasakayuprofesional.com/' }, areaServed: { '@type': 'City', name: 'Tangerang Selatan', containedInPlace: { '@type': 'AdministrativeArea', name: 'Banten' } }, url: canonical },
    { '@type': 'FAQPage', mainEntity: faqs.map(([question, answer]) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) },
    { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://www.jasakayuprofesional.com/' }, { '@type': 'ListItem', position: 2, name: 'Layanan', item: 'https://www.jasakayuprofesional.com/#layanan' }, { '@type': 'ListItem', position: 3, name: 'Jasa Kayu Tangerang Selatan', item: canonical }] },
  ],
};
---

<Layout title={title} description={description} canonical={canonical} image="/images/portfolio/deck-apartemen-dharmawangsa.webp">
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <section class="relative overflow-hidden bg-[#17352a] pb-20 pt-32 text-[#fffdf7] sm:pb-28 sm:pt-44">
    <div class="absolute inset-0 opacity-25"><Image src={dharmawangsa} alt="Deck kayu pada balkon apartemen" class="h-full w-full object-cover" width={1600} height={900} loading="eager" fetchpriority="high" /></div><div class="absolute inset-0 bg-gradient-to-r from-[#17352a] via-[#17352a]/90 to-[#17352a]/45" />
    <div class="section-shell relative grid gap-12 lg:grid-cols-[1fr_.75fr] lg:items-end"><div><p class="section-kicker text-[#e6c88f]">Area layanan · Tangerang Selatan</p><h1 class="display-title mt-5 max-w-4xl text-5xl sm:text-6xl lg:text-8xl">Jasa kayu untuk ruang di <em>Tangsel.</em></h1><p class="mt-7 max-w-2xl text-base leading-7 text-white/75 sm:text-lg">Dari decking balkon di hunian vertikal sampai lantai kayu dan detail custom di rumah BSD atau Bintaro. Kami bantu membaca kondisi area sebelum memilih material.</p><div class="mt-9 flex flex-wrap gap-3"><a href="#kontak" class="btn-wood !bg-[#e6c88f] !text-[#17231d]">Kirim foto area <span aria-hidden="true">↗</span></a><a href="#cakupan" class="inline-flex items-center rounded-full border border-white/35 px-5 py-3 text-xs font-extrabold uppercase tracking-[.12em] transition hover:bg-white hover:text-[#17352a]">Lihat cakupan</a></div></div><div class="border-l border-white/25 pl-6 text-sm leading-7 text-white/70"><p class="text-[#e6c88f]">Yang kami kerjakan</p><p class="mt-3">Lantai kayu solid atau engineered, decking dan pergola, tangga kayu, wall panel, ceiling, serta built-in custom.</p></div></div>
  </section>
  <section id="cakupan" class="bg-[#f4f2eb] py-20 sm:py-28"><div class="section-shell grid gap-12 lg:grid-cols-[.7fr_1.3fr] lg:items-start"><div><p class="section-kicker">Membaca lokasi</p><h2 class="display-title mt-5 text-5xl text-[#17231d] sm:text-6xl">Dekat dengan proyek,<br /><em>jelas sejak awal.</em></h2></div><div class="grid gap-px overflow-hidden border border-[#17231d]/15 bg-[#17231d]/15 sm:grid-cols-2">{[['BSD & Serpong','Rumah cluster, townhouse, area komersial, dan ruang outdoor yang perlu detail rapi serta tahan pemakaian harian.'],['Bintaro & Pondok Aren','Lantai kayu, tangga, wall panel, dan built-in untuk hunian yang membutuhkan koordinasi detail dengan interior.'],['Pamulang & Ciputat','Kami bantu mulai dari foto, ukuran kasar, kondisi bidang, hingga opsi material yang masuk akal untuk ruang Anda.'],['Setu & Tangerang','Area di luar cakupan utama tetap bisa dibahas berdasarkan jadwal, akses lokasi, dan skala pekerjaan.']].map(([area, text], index) => <div class="bg-[#f4f2eb] p-7"><p class="text-[.62rem] font-extrabold uppercase tracking-[.14em] text-[#315443]">0{index + 1} · Tangsel</p><h3 class="mt-4 font-serif text-3xl font-semibold text-[#17231d]">{area}</h3><p class="mt-3 text-sm leading-7 text-[#59645b]">{text}</p></div>)}</div></div></section>
  <section class="bg-[#e7dfd0] py-20 sm:py-28"><div class="section-shell grid gap-10 lg:grid-cols-[1.1fr_.9fr] lg:items-center"><div class="overflow-hidden"><Image src={deckingUlin} alt="Detail decking kayu outdoor" width={1200} height={800} loading="lazy" format="webp" class="aspect-[4/3] w-full object-cover" /></div><div><p class="section-kicker">Cara mulai</p><h2 class="display-title mt-5 text-5xl text-[#17231d] sm:text-6xl">Tidak perlu menunggu gambar kerja <em>lengkap.</em></h2><ol class="mt-8 space-y-5 border-t border-[#17231d]/15 pt-6 text-sm leading-7 text-[#59645b]"><li><strong class="text-[#17231d]">01 · Kirim konteks.</strong> Foto area, ukuran kasar, lokasi, dan kebutuhan utama.</li><li><strong class="text-[#17231d]">02 · Baca kemungkinan.</strong> Kami bahas material, detail teknis, akses, serta hal yang perlu dicek di lokasi.</li><li><strong class="text-[#17231d]">03 · Susun scope.</strong> Setelah arah jelas, barulah jadwal survei dan estimasi dibicarakan.</li></ol><a href="#kontak" class="btn-wood mt-8">Mulai dari foto area <span aria-hidden="true">↗</span></a></div></div></section>
  <section class="bg-[#f4f2eb] py-20 sm:py-28"><div class="section-shell max-w-4xl"><p class="section-kicker">Pertanyaan yang sering muncul</p><h2 class="display-title mt-5 text-5xl text-[#17231d] sm:text-6xl">Biar langkah pertama terasa <em>ringan.</em></h2><div class="mt-10 divide-y divide-[#17231d]/15 border-y border-[#17231d]/15">{faqs.map(([question, answer]) => <details class="group py-6"><summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-serif text-2xl font-semibold text-[#17231d]"><span>{question}</span><span class="text-3xl font-normal text-[#315443] transition group-open:rotate-45">+</span></summary><p class="mt-4 max-w-2xl text-sm leading-7 text-[#59645b]">{answer}</p></details>)}</div></div></section>
  <Contact />
  <Footer slot="footer" />
</Layout>
