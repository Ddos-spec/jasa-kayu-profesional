---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import heroImage from '../../assets/images/portfolio/tangga-modern-bsd.jpg';

const title = 'Jasa Kayu Tangerang Selatan & BSD | Decking, Lantai, Tangga';
const description = 'Jasa kayu untuk Tangerang Selatan, BSD, Bintaro, Serpong, Pamulang, Ciputat, dan Pondok Aren. Lantai kayu, decking, tangga, wall panel, ceiling, dan detail custom dengan scope yang dibaca dari kondisi proyek.';
const canonical = 'https://www.jasakayuprofesional.com/layanan/jasa-kayu-tangsel';
const areas = [
  ['BSD & Serpong', 'Hunian cluster, townhouse, dan ruang komersial dengan kebutuhan lantai, tangga, wall panel, atau detail kayu custom.'],
  ['Bintaro & Pondok Aren', 'Pengerjaan interior dan outdoor dengan koordinasi akses, existing finish, built-in, serta jadwal kerja di area hunian.'],
  ['Pamulang & Ciputat', 'Diskusi dapat dimulai dari foto, ukuran kasar, kondisi bidang, dan tujuan ruang sebelum penjadwalan survei.'],
  ['Setu & sekitarnya', 'Cakupan dibahas berdasarkan lokasi, akses, skala pekerjaan, serta kebutuhan logistik material dan tim.'],
];
const faqs = [
  ['Apakah melayani seluruh Tangerang Selatan?', 'Kami melayani BSD, Serpong, Bintaro, Pondok Aren, Ciputat, Pamulang, Setu, dan area Tangsel lain berdasarkan jadwal serta scope proyek.'],
  ['Bisa mulai konsultasi tanpa gambar kerja?', 'Bisa. Foto area dari beberapa sudut, ukuran kasar, lokasi, dan kebutuhan utama sudah cukup untuk membuka diskusi awal.'],
  ['Apa yang menentukan estimasi pengerjaan?', 'Jenis material, ukuran area, kondisi existing, detail sambungan, akses lokasi, finishing, dan kompleksitas instalasi memengaruhi scope akhir.'],
];
const schema = {
  '@context': 'https://schema.org', '@graph': [
    { '@type': 'Service', name: 'Jasa Kayu Tangerang Selatan dan BSD', serviceType: 'Pengerjaan kayu custom', description, provider: { '@type': 'Organization', name: 'Jasa Kayu Profesional', url: 'https://www.jasakayuprofesional.com/' }, areaServed: { '@type': 'City', name: 'Tangerang Selatan', containedInPlace: { '@type': 'AdministrativeArea', name: 'Banten' } }, url: canonical },
    { '@type': 'FAQPage', mainEntity: faqs.map(([question, answer]) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) },
    { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://www.jasakayuprofesional.com/' }, { '@type': 'ListItem', position: 2, name: 'Layanan', item: 'https://www.jasakayuprofesional.com/#layanan' }, { '@type': 'ListItem', position: 3, name: 'Jasa Kayu Tangerang Selatan', item: canonical }] },
  ],
};
---
<Layout title={title} description={description} canonical={canonical} image="/images/portfolio/tangga-modern-bsd.jpg">
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <section class="relative min-h-[48rem] overflow-hidden bg-[#17352a] text-[#fffdf7] lg:min-h-[88vh]">
    <Image src={heroImage} alt="Pengerjaan tangga kayu pada hunian BSD" width={1700} height={1100} loading="eager" fetchpriority="high" format="webp" class="absolute inset-0 h-full w-full object-cover opacity-60" />
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(10,31,23,.94)_0%,rgba(10,31,23,.75)_48%,rgba(10,31,23,.25)_100%)]"></div><div class="grid-lines absolute inset-0 opacity-25"></div>
    <div class="section-shell relative flex min-h-[48rem] flex-col justify-end pb-10 pt-36 lg:min-h-[88vh] lg:pb-14">
      <p class="reveal section-kicker text-[#e6c88f]">Area kerja · Tangerang Selatan</p>
      <h1 class="reveal display-title mt-6 max-w-6xl text-[clamp(4.5rem,10vw,9rem)]">Pengerjaan kayu yang memahami konteks <em>Tangsel.</em></h1>
      <div class="reveal mt-8 grid gap-8 border-t border-white/25 pt-6 lg:grid-cols-[1.2fr_.8fr] lg:items-end"><p class="max-w-2xl text-base leading-7 text-white/70 sm:text-lg sm:leading-8">BSD, Serpong, Bintaro, Pamulang, Ciputat, hingga Pondok Aren memiliki tipe hunian, akses, existing condition, dan kebutuhan proyek yang berbeda. Kami mulai dari kondisi nyata sebelum bicara material.</p><a href="#kontak" class="group flex items-center justify-between border-b border-white/30 pb-3 text-[.66rem] font-extrabold uppercase tracking-[.13em] text-[#e6c88f] lg:justify-self-end lg:min-w-[15rem]">Kirim lokasi & foto <span class="text-xl transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true">↗</span></a></div>
      <div class="reveal mt-10 grid gap-px border border-white/15 bg-white/15 sm:grid-cols-2 lg:grid-cols-4">{[['Coverage','BSD / Serpong'],['Coverage','Bintaro / Pondok Aren'],['Coverage','Pamulang / Ciputat'],['Scope','Interior / Outdoor / Custom']].map(([a,b]) => <div class="bg-[#17352a]/70 p-4 backdrop-blur-sm"><p class="text-[.55rem] font-extrabold uppercase tracking-[.15em] text-white/40">{a}</p><p class="mt-2 text-sm font-bold text-white/90">{b}</p></div>)}</div>
    </div>
  </section>

  <section id="cakupan" class="bg-[#f4f2eb] py-24 sm:py-32 lg:py-40"><div class="section-shell grid gap-12 lg:grid-cols-[.52fr_1.48fr]"><div class="reveal sticky-copy self-start"><p class="section-kicker">Cakupan proyek</p><h2 class="display-title mt-6 text-5xl text-[#17231d] sm:text-6xl">Dekat secara lokasi,<br /><em>jelas secara scope.</em></h2><p class="mt-6 max-w-sm text-sm leading-7 text-[#68736a]">Halaman lokal tidak berguna kalau hanya mengganti nama kota. Yang lebih penting adalah akses, tipe proyek, dan konteks lapangan.</p></div><div class="reveal-stagger grid gap-px border border-[#17231d]/15 bg-[#17231d]/15 sm:grid-cols-2">{areas.map(([area,text],index) => <div class="bg-[#f4f2eb] p-7 sm:p-8"><p class="text-[.58rem] font-extrabold uppercase tracking-[.15em] text-[#315443]">0{index+1} · Tangsel</p><h3 class="mt-5 font-serif text-4xl font-semibold leading-[.92] tracking-[-.045em] text-[#17231d]">{area}</h3><p class="mt-4 text-sm leading-7 text-[#59645b]">{text}</p></div>)}</div></div></section>

  <section class="bg-[#e7dfd0] py-24 sm:py-32 lg:py-40"><div class="section-shell grid gap-12 lg:grid-cols-[.8fr_1.2fr] lg:items-center"><div class="reveal"><p class="section-kicker">Local proof</p><p class="mt-6 text-[.6rem] font-extrabold uppercase tracking-[.15em] text-[#7b847c]">BSD · Residential staircase</p><h2 class="display-title mt-5 text-5xl text-[#17231d] sm:text-6xl lg:text-7xl">Tangga modern di <em>BSD.</em></h2><p class="mt-6 max-w-xl text-sm leading-7 text-[#59645b]">Dokumentasi proyek lokal lebih berguna daripada klaim generik “melayani Tangsel”. Lihat bagaimana material dan detail diterjemahkan dalam proyek yang benar-benar berada di area BSD.</p><a href="/portfolio/tangga-modern-bsd" class="group mt-8 flex max-w-sm items-center justify-between border-b border-[#17231d]/20 pb-3 text-[.66rem] font-extrabold uppercase tracking-[.13em] text-[#315443]">Lihat project dossier <span class="text-xl transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true">↗</span></a></div><a href="/portfolio/tangga-modern-bsd" class="reveal image-zoom block overflow-hidden bg-[#d7c9b3]"><Image src={heroImage} alt="Detail proyek tangga kayu di BSD" width={1200} height={900} loading="lazy" format="webp" class="aspect-[4/3] w-full object-cover" /></a></div></section>

  <section class="bg-[#f4f2eb] py-24 sm:py-32"><div class="section-shell max-w-5xl"><div class="grid gap-8 border-b border-[#17231d]/15 pb-8 sm:grid-cols-[.55fr_1.45fr] sm:items-end"><p class="reveal section-kicker">FAQ lokal</p><h2 class="reveal display-title text-5xl text-[#17231d] sm:text-6xl">Mulai tanpa membuatnya <em>rumit.</em></h2></div><div class="reveal-stagger mt-4 divide-y divide-[#17231d]/15 border-b border-[#17231d]/15">{faqs.map(([question,answer]) => <details class="group py-6"><summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-serif text-2xl font-semibold leading-tight tracking-[-.03em] text-[#17231d] sm:text-3xl"><span>{question}</span><span class="text-3xl font-normal text-[#315443] transition group-open:rotate-45">+</span></summary><p class="mt-4 max-w-2xl text-sm leading-7 text-[#59645b]">{answer}</p></details>)}</div></div></section>

  <Contact />
  <Footer slot="footer" />
</Layout>
