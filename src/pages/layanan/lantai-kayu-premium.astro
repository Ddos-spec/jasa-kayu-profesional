---
import Layout from '../../layouts/Layout.astro';
import ServiceEditorial from '../../components/ServiceEditorial.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import heroImage from '../../assets/images/portfolio/villa-puncak-lantai-jati-solid.jpg';
import detailImage from '../../assets/images/portfolio/lantai-kayu-merbau-vila-palma-kemang/lantai-kayu-merbau-vila-palma-kemang-1.jpg';

const title = 'Jasa Pasang Lantai Kayu Jati & Merbau Jabodetabek | Jasa Kayu Profesional';
const description = 'Perencanaan dan pemasangan lantai kayu solid maupun engineered di Jabodetabek. Pemilihan material, pola, subfloor, sambungan, dan finishing dibahas sebagai satu sistem.';
const canonical = 'https://www.jasakayuprofesional.com/layanan/lantai-kayu-premium';
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Jasa Pasang Lantai Kayu',
  serviceType: 'Pemasangan lantai kayu solid dan engineered',
  description,
  provider: { '@type': 'Organization', name: 'Jasa Kayu Profesional', url: 'https://www.jasakayuprofesional.com/' },
  areaServed: ['Jakarta', 'Bogor', 'Depok', 'Tangerang', 'Bekasi'].map((name) => ({ '@type': 'AdministrativeArea', name })),
  url: canonical,
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Apa beda lantai kayu solid dan engineered?', acceptedAnswer: { '@type': 'Answer', text: 'Lantai solid menggunakan kayu utuh pada ketebalan papan, sedangkan engineered memakai lapisan kayu pada konstruksi berlapis. Pilihan terbaik bergantung pada kondisi subfloor, stabilitas ruang, pola pemasangan, dan kebutuhan perawatan.' } },
    { '@type': 'Question', name: 'Apa yang perlu disiapkan sebelum meminta estimasi?', acceptedAnswer: { '@type': 'Answer', text: 'Foto area, ukuran kasar, lokasi proyek, kondisi lantai dasar, jenis ruang, serta referensi pola sudah cukup untuk diskusi awal. Estimasi final mengikuti scope dan kondisi aktual.' } },
    { '@type': 'Question', name: 'Apakah semua ruang cocok memakai lantai kayu?', acceptedAnswer: { '@type': 'Answer', text: 'Tidak selalu. Tingkat kelembapan, risiko air, kondisi subfloor, dan pola pemakaian perlu diperiksa lebih dulu sebelum menentukan material maupun metode pemasangan.' } },
  ],
};
---
<Layout title={title} description={description} canonical={canonical} image="/images/portfolio/villa-puncak-lantai-jati-solid.jpg">
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <ServiceEditorial
    kicker="Flooring · Interior"
    title="Lantai kayu yang mengikuti ruang, bukan tren."
    intro="Lantai adalah bidang terbesar yang disentuh setiap hari. Karena itu jenis kayu, stabilitas subfloor, arah pola, sambungan perimeter, dan finishing perlu dibaca sebagai satu keputusan, bukan daftar item terpisah."
    heroImage={heroImage}
    heroAlt="Lantai kayu solid pada interior vila"
    secondaryImage={detailImage}
    secondaryAlt="Detail lantai kayu Merbau pada hunian"
    facts={[
      { label: 'Format', value: 'Solid / Engineered' },
      { label: 'Material', value: 'Jati / Merbau / opsi sesuai konteks' },
      { label: 'Pola', value: 'Plank / Herringbone / custom' },
      { label: 'Area', value: 'Jabodetabek' },
    ]}
    statement="Lantai yang tenang secara visual lahir dari keputusan teknis yang tidak terlihat."
    principles={[
      { title: 'Subfloor dulu', text: 'Kerataan, kelembapan, elevasi akhir, dan pertemuan dengan material lain harus dibaca sebelum menentukan sistem pemasangan.' },
      { title: 'Arah papan', text: 'Arah serat dan modul papan memengaruhi persepsi panjang ruang, titik potong, serta bagaimana pola bertemu pintu dan built-in.' },
      { title: 'Movement gap', text: 'Kayu merespons perubahan kelembapan. Detail perimeter dan sambungan perlu memberi ruang bagi pergerakan material.' },
      { title: 'Finishing sebagai sistem', text: 'Warna bukan satu-satunya pertimbangan. Kilap, tekstur, reparability, dan ritme maintenance ikut menentukan pilihan akhir.' },
    ]}
    materials={[
      { name: 'Jati', note: 'Karakter hangat dan serat yang kuat secara visual. Cocok ketika material lantai memang ingin menjadi bagian utama dari identitas ruang.' },
      { name: 'Merbau', note: 'Tone lebih dalam dengan karakter solid. Perlu dibaca bersama pencahayaan, warna dinding, dan material furnitur agar ruang tetap seimbang.' },
      { name: 'Engineered wood', note: 'Opsi ketika stabilitas konstruksi berlapis lebih relevan terhadap kondisi ruang dan sistem pemasangan yang direncanakan.' },
    ]}
    process={[
      { title: 'Baca kondisi', text: 'Cek area, subfloor, elevasi, kelembapan, akses, serta titik pertemuan dengan pintu, skirting, batu, atau built-in.' },
      { title: 'Tentukan sistem', text: 'Material, dimensi papan, pola, arah pemasangan, adhesive atau metode fixing, serta kebutuhan transisi disepakati sebelum eksekusi.' },
      { title: 'Layout & instalasi', text: 'Pola diuji terhadap dimensi ruang supaya potongan akhir, garis sambungan, dan pusat komposisi tidak terasa kebetulan.' },
      { title: 'Finishing & handover', text: 'Permukaan, tepi, transisi, dan kondisi akhir diperiksa sebelum panduan perawatan diberikan untuk fase penggunaan.' },
    ]}
  >
    <section class="bg-[#fffdf7] py-24 sm:py-32 lg:py-40">
      <div class="section-shell">
        <div class="grid gap-10 border-b border-[#17231d]/15 pb-10 lg:grid-cols-[.55fr_1.45fr] lg:items-end"><p class="reveal section-kicker">Solid vs engineered</p><div class="reveal"><h2 class="display-title text-5xl text-[#17231d] sm:text-6xl lg:text-8xl">Bukan soal mana yang lebih <em>mahal.</em></h2><p class="mt-6 max-w-2xl text-sm leading-7 text-[#59645b]">Pertanyaan yang lebih berguna adalah: konstruksi mana yang paling masuk akal untuk kondisi ruang, ekspektasi pemakaian, dan cara proyek akan dirawat.</p></div></div>
        <div class="reveal-stagger mt-10 grid gap-px border border-[#17231d]/15 bg-[#17231d]/15 lg:grid-cols-2">
          <div class="bg-[#fffdf7] p-7 sm:p-10"><p class="text-[.6rem] font-extrabold uppercase tracking-[.15em] text-[#315443]">01 / Solid timber</p><h3 class="mt-6 font-serif text-5xl font-semibold leading-[.9] tracking-[-.05em] text-[#17231d]">Material utuh, karakter kuat.</h3><ul class="mt-8 space-y-4 text-sm leading-7 text-[#59645b]"><li class="border-t border-[#17231d]/15 pt-4">Cocok ketika karakter kayu asli menjadi fokus utama ruang.</li><li class="border-t border-[#17231d]/15 pt-4">Memerlukan perhatian serius pada kadar air, subfloor, ekspansi, dan maintenance.</li><li class="border-t border-[#17231d]/15 pt-4">Pola dan dimensi papan perlu direncanakan terhadap proporsi ruang.</li></ul></div>
          <div class="bg-[#e7dfd0] p-7 sm:p-10"><p class="text-[.6rem] font-extrabold uppercase tracking-[.15em] text-[#315443]">02 / Engineered</p><h3 class="mt-6 font-serif text-5xl font-semibold leading-[.9] tracking-[-.05em] text-[#17231d]">Konstruksi berlapis, konteks berbeda.</h3><ul class="mt-8 space-y-4 text-sm leading-7 text-[#59645b]"><li class="border-t border-[#17231d]/15 pt-4">Layak dipertimbangkan ketika stabilitas dimensional menjadi prioritas.</li><li class="border-t border-[#17231d]/15 pt-4">Kualitas tetap bergantung pada konstruksi produk, wear layer, subfloor, dan instalasi.</li><li class="border-t border-[#17231d]/15 pt-4">Visual akhirnya tetap harus dibaca bersama pencahayaan dan material lain.</li></ul></div>
        </div>
      </div>
    </section>
  </ServiceEditorial>

  <Contact />
  <Footer slot="footer" />
</Layout>
