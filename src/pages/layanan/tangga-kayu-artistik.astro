---
import Layout from '../../layouts/Layout.astro';
import ServiceEditorial from '../../components/ServiceEditorial.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import heroImage from '../../assets/images/portfolio/penthouse-scbd-spiral-staircase.jpg';
import detailImage from '../../assets/images/portfolio/tangga-modern-bsd.jpg';

const title = 'Jasa Tangga Kayu Custom Jabodetabek | Jasa Kayu Profesional';
const description = 'Perencanaan dan pemasangan trap tangga kayu, cladding tangga, floating staircase, serta detail railing di Jabodetabek dengan perhatian pada struktur, ergonomi, nosing, sambungan, dan finishing.';
const canonical = 'https://www.jasakayuprofesional.com/layanan/tangga-kayu-artistik';
const serviceSchema = {
  '@context': 'https://schema.org', '@type': 'Service', name: 'Jasa Tangga Kayu Custom', serviceType: 'Pemasangan dan finishing tangga kayu', description,
  provider: { '@type': 'Organization', name: 'Jasa Kayu Profesional', url: 'https://www.jasakayuprofesional.com/' },
  areaServed: ['Jakarta','Bogor','Depok','Tangerang','Bekasi'].map((name) => ({ '@type': 'AdministrativeArea', name })), url: canonical,
};
---
<Layout title={title} description={description} canonical={canonical} image="/images/portfolio/penthouse-scbd-spiral-staircase.jpg">
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <ServiceEditorial
    kicker="Staircase · Architectural detail"
    title="Tangga bukan furnitur. Ia adalah gerakan yang dibangun."
    intro="Setiap anak tangga menerima beban, hentakan, dan kontak berulang. Dimensi tread-riser, struktur dasar, nosing, sambungan, railing, dan transisi lantai harus terasa konsisten sebelum bentuknya bisa disebut indah."
    heroImage={heroImage}
    heroAlt="Tangga spiral dengan elemen kayu pada penthouse"
    secondaryImage={detailImage}
    secondaryAlt="Detail tangga kayu modern pada hunian BSD"
    facts={[
      { label: 'Format', value: 'Straight / L / U / Spiral / Floating' },
      { label: 'Scope', value: 'Tread / Riser / Cladding / Detail' },
      { label: 'Interface', value: 'Steel / Concrete / Timber' },
      { label: 'Area', value: 'Jabodetabek' },
    ]}
    statement="Tangga yang terasa mahal biasanya bukan karena bentuk rumit, tetapi karena setiap langkah terasa pasti."
    principles={[
      { title: 'Ergonomi dulu', text: 'Riser, tread, nosing, landing, headroom, dan ritme langkah harus dibaca sebagai sistem. Visual tidak boleh mengorbankan kenyamanan bergerak.' },
      { title: 'Baca struktur', text: 'Beton, baja, atau struktur kayu memiliki toleransi dan metode fixing berbeda. Cladding kayu tidak boleh dipakai untuk menyamarkan masalah struktur.' },
      { title: 'Edge control', text: 'Nosing, sudut, pertemuan riser-tread, side stringer, dan sambungan panjang adalah area yang paling sering menerima benturan dan paling mudah terlihat.' },
      { title: 'Railing integration', text: 'Handrail, baluster, kaca, atau baja harus bertemu kayu dengan detail yang konsisten dan tetap mempertimbangkan keamanan penggunaan.' },
    ]}
    materials={[
      { name: 'Jati', note: 'Karakter hangat dengan serat yang kuat. Cocok untuk tread atau cladding ketika kayu ingin tampil sebagai material utama.' },
      { name: 'Merbau', note: 'Tone lebih dalam dan karakter solid; perlu diseimbangkan dengan pencahayaan serta material railing atau lantai sekitar.' },
      { name: 'Timber + steel', note: 'Kombinasi umum untuk floating atau sculptural stair. Toleransi antara struktur baja dan skin kayu harus direncanakan sejak fabrikasi.' },
    ]}
    process={[
      { title: 'Measure the run', text: 'Cek dimensi aktual, level antar lantai, headroom, lebar tangga, kondisi struktur, serta titik pertemuan dengan lantai atas dan bawah.' },
      { title: 'Resolve the detail', text: 'Tread, riser, nosing, edge, cladding, fixing, railing, dan finishing diputuskan sebelum produksi.' },
      { title: 'Fit & align', text: 'Pemasangan mengontrol level, ritme anak tangga, joint, bunyi, dan pertemuan dengan struktur maupun dinding.' },
      { title: 'Finish for touch', text: 'Permukaan dan tepi diselesaikan untuk kontak harian, termasuk tekstur, kilap, grip, serta kemudahan perawatan.' },
    ]}
  >
    <section class="bg-[#fffdf7] py-24 sm:py-32 lg:py-40">
      <div class="section-shell">
        <div class="grid gap-10 lg:grid-cols-[.52fr_1.48fr]"><div class="reveal sticky-copy self-start"><p class="section-kicker">Stair anatomy</p><p class="mt-6 max-w-xs text-sm leading-7 text-[#68736a]">Tangga dilihat sebagai satu objek, tapi kualitasnya terbentuk dari beberapa garis kecil yang harus bertemu dengan tepat.</p></div><div class="reveal-stagger grid gap-px border border-[#17231d]/15 bg-[#17231d]/15 sm:grid-cols-2 lg:grid-cols-4">{[['01','Tread','Bidang pijakan: lebar, arah serat, sambungan, dan stabilitas.'],['02','Nosing','Tepi depan yang menerima benturan sekaligus membentuk shadow line.'],['03','Riser','Bidang vertikal yang menentukan ritme visual dan kebersihan joint.'],['04','Rail','Titik sentuh tangan dan elemen keselamatan yang harus menyatu dengan struktur.']].map(([n,h,t]) => <div class="bg-[#fffdf7] p-7"><p class="text-[.58rem] font-extrabold uppercase tracking-[.15em] text-[#315443]">{n}</p><h2 class="mt-6 font-serif text-4xl font-semibold leading-[.92] tracking-[-.045em] text-[#17231d]">{h}</h2><p class="mt-5 text-sm leading-7 text-[#59645b]">{t}</p></div>)}</div></div>
      </div>
    </section>
  </ServiceEditorial>
  <Contact />
  <Footer slot="footer" />
</Layout>
