---
import Layout from '../../layouts/Layout.astro';
import ServiceEditorial from '../../components/ServiceEditorial.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import heroImage from '../../assets/images/portfolio/hotel-boutique-bandung-lobby-ceiling.jpg';

const title = 'Jasa Plafon Kayu & Lambersering Jabodetabek | Jasa Kayu Profesional';
const description = 'Perencanaan dan pemasangan plafon kayu, lambersering, dan ceiling timber di Jabodetabek dengan perhatian pada modul, rangka, pencahayaan, ventilasi, akses service, dan finishing.';
const canonical = 'https://www.jasakayuprofesional.com/layanan/plafon-kayu-ceiling';
const serviceSchema = {
  '@context': 'https://schema.org', '@type': 'Service', name: 'Jasa Plafon Kayu dan Lambersering', serviceType: 'Pemasangan plafon kayu dan timber ceiling', description,
  provider: { '@type': 'Organization', name: 'Jasa Kayu Profesional', url: 'https://www.jasakayuprofesional.com/' },
  areaServed: ['Jakarta','Bogor','Depok','Tangerang','Bekasi'].map((name) => ({ '@type': 'AdministrativeArea', name })), url: canonical,
};
---
<Layout title={title} description={description} canonical={canonical} image="/images/portfolio/hotel-boutique-bandung-lobby-ceiling.jpg">
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <ServiceEditorial
    kicker="Ceiling · Interior"
    title="Lihat ke atas. Ceiling juga membentuk cara ruang terasa."
    intro="Plafon kayu mengubah skala, arah pandang, ritme cahaya, dan karakter akustik sebuah ruang. Agar tidak terasa berat, modul bilah, tone, rangka, sambungan, dan integrasi lighting harus dibaca sejak awal."
    heroImage={heroImage}
    heroAlt="Plafon kayu pada lobby hotel"
    facts={[
      { label: 'Format', value: 'Lambersering / Slat / Panel' },
      { label: 'Integration', value: 'Lighting / HVAC / Access' },
      { label: 'Context', value: 'Residential / Hospitality' },
      { label: 'Area', value: 'Jabodetabek' },
    ]}
    statement="Ceiling kayu yang baik membuat ruang terasa selesai tanpa membuat mata terus menatap ke atas."
    principles={[
      { title: 'Scale & direction', text: 'Arah bilah dan ukuran modul dapat memanjangkan, melebar, atau menurunkan persepsi ruang. Proporsi harus mengikuti arsitektur, bukan katalog.' },
      { title: 'Service coordination', text: 'Lampu, diffuser AC, sprinkler, speaker, access panel, dan curtain pocket harus masuk ke grid yang sama agar ceiling tidak terlihat ditambal.' },
      { title: 'Substructure', text: 'Rangka, level, titik gantung, dan kondisi slab menentukan kestabilan bidang serta presisi garis akhir.' },
      { title: 'Tone & shadow', text: 'Kayu di ceiling menerima cahaya berbeda dari dinding atau lantai. Sample perlu dilihat pada arah cahaya aktual sebelum warna diputuskan.' },
    ]}
    materials={[
      { name: 'Lambersering solid', note: 'Profil berulang dengan karakter kayu nyata; cocok saat ritme linear menjadi bagian dari bahasa ruang.' },
      { name: 'Slatted ceiling', note: 'Memberi kedalaman bayangan dan bisa membantu menyamarkan service tertentu jika koordinasinya direncanakan sejak awal.' },
      { name: 'Panel timber', note: 'Bidang lebih tenang dan monolitik; detail joint dan perubahan arah serat menjadi kunci kualitas visual.' },
    ]}
    planningChecks={[
      { title: 'Ceiling services', text: 'Lampu, AC, sprinkler, speaker, smoke detector, curtain pocket, CCTV, dan access panel dimapping sebelum modul kayu dikunci.' },
      { title: 'Level & support', text: 'Ketinggian bersih, beam, slab, rangka existing, titik gantung, dan toleransi level menentukan seberapa presisi garis panjang bisa dijaga.' },
      { title: 'Module alignment', text: 'Arah bilah atau panel sebaiknya berhubungan dengan sumbu ruang, pintu, furniture utama, lighting, dan bidang ceiling lain.' },
      { title: 'Maintenance access', text: 'Area yang perlu servis berkala harus tetap dapat dibuka tanpa membuat ceiling penuh hatch yang terlihat seperti tambalan.' },
    ]}
    process={[
      { title: 'Map the ceiling', text: 'Cek level, struktur atas, posisi lighting, HVAC, speaker, sprinkler, curtain pocket, dan kebutuhan access panel.' },
      { title: 'Set the rhythm', text: 'Modul bilah atau panel, arah, reveal, border, serta titik berhenti disusun terhadap geometri ruang.' },
      { title: 'Build the frame', text: 'Rangka dibuat pada level yang terkontrol dengan toleransi yang cukup untuk service dan pergerakan material.' },
      { title: 'Install & align', text: 'Pemasangan dilakukan sambil mengecek garis pandang panjang, joint, sudut, bukaan lampu, serta finishing akhir.' },
    ]}
    estimateFactors={[
      { title: 'Ketinggian & akses kerja', text: 'Ceiling rendah pada rumah dan ceiling tinggi di lobby atau void membutuhkan akses, scaffold, sequencing, serta waktu kerja yang berbeda.' },
      { title: 'Jenis profil & modul', text: 'Lambersering, slat custom, panel besar, radius, border, dan perubahan arah memiliki kebutuhan fabrikasi serta waste yang berbeda.' },
      { title: 'Jumlah service', text: 'Semakin banyak lampu, diffuser, sprinkler, speaker, sensor, atau access hatch, semakin banyak koordinasi dan detail potongan yang dibutuhkan.' },
      { title: 'Rangka & finishing', text: 'Kondisi support, kebutuhan leveling, backing, treatment, stain, coating, dan detail edge ikut membentuk scope akhir.' },
    ]}
    aftercare={[
      { title: 'Dust control', text: 'Bilah dan groove ceiling mengumpulkan debu. Pembersihan berkala dengan alat yang tidak membasahi kayu membantu warna tetap konsisten.' },
      { title: 'Leak response', text: 'Jika ada kebocoran dari atap, AC, atau plumbing, sumber air harus dihentikan lebih dulu dan panel terdampak dikeringkan sebelum evaluasi finishing.' },
      { title: 'Service discipline', text: 'Pekerjaan listrik atau HVAC berikutnya sebaiknya memakai access point yang sudah disiapkan, bukan memotong ceiling pada titik baru tanpa koordinasi.' },
      { title: 'Finish touch-up', text: 'Area tertentu dapat berubah karena panas lampu atau kelembapan. Touch-up lebih rapi bila sistem finishing awal terdokumentasi dengan jelas.' },
    ]}
    faqs={[
      { question: 'Ceiling kayu bikin ruangan terasa lebih rendah?', answer: 'Bisa jika modul, tone, dan elevasinya tidak tepat. Karena itu arah bilah, ukuran profil, warna, dan jarak visual terhadap dinding perlu dibaca bersama tinggi ruang.' },
      { question: 'Bisa digabung dengan lampu linear dan AC?', answer: 'Bisa. Justru hasil paling rapi terjadi ketika posisi lighting dan HVAC ditentukan bersama modul kayu sejak awal, bukan dilubangi setelah pemasangan selesai.' },
      { question: 'Apakah perlu rangka baru?', answer: 'Tergantung kondisi ceiling/slab existing, level, bentang, profil yang dipakai, dan kebutuhan service. Rangka baru kadang diperlukan untuk mendapatkan bidang yang stabil dan lurus.' },
      { question: 'Apa yang perlu dikirim untuk estimasi?', answer: 'Foto ceiling, ukuran ruang, tinggi, lokasi, posisi lampu/AC jika sudah ada, serta referensi profil atau tone cukup untuk diskusi awal.' },
    ]}
  >
    <section class="bg-[#fffdf7] py-24 sm:py-32 lg:py-40">
      <div class="section-shell grid gap-10 lg:grid-cols-[.55fr_1.45fr]">
        <div class="reveal sticky-copy self-start"><p class="section-kicker">Ceiling coordination</p><p class="mt-6 max-w-xs text-sm leading-7 text-[#68736a]">Ceiling adalah tempat banyak sistem bertemu. Kualitas visualnya bergantung pada seberapa awal semuanya dikoordinasikan.</p></div>
        <div class="reveal-stagger grid gap-px border border-[#17231d]/15 bg-[#17231d]/15 sm:grid-cols-2">
          {[['01','Light','Downlight, linear light, cove, dan bayangan harus mengikuti modul, bukan memotongnya secara acak.'],['02','Air','Diffuser dan return grille perlu diposisikan agar tetap terbaca sebagai bagian dari komposisi.'],['03','Access','Akses maintenance harus tetap mungkin tanpa membuat bidang ceiling penuh hatch yang mengganggu.'],['04','Edge','Pertemuan dengan dinding, curtain pocket, beam, atau area ceiling berbeda menentukan kesan akhir.']].map(([n,h,t]) => <div class="bg-[#fffdf7] p-7"><p class="text-[.58rem] font-extrabold uppercase tracking-[.15em] text-[#315443]">{n}</p><h2 class="mt-6 font-serif text-4xl font-semibold leading-[.92] tracking-[-.045em] text-[#17231d]">{h}</h2><p class="mt-5 text-sm leading-7 text-[#59645b]">{t}</p></div>)}
        </div>
      </div>
    </section>
  </ServiceEditorial>
  <Contact />
  <Footer slot="footer" />
</Layout>
