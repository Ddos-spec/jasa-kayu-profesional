---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import heroImage from '../../assets/images/portfolio/deck-ulin-rancamaya-bogor/deck-ulin-rancamaya-bogor-1.jpg';
import detailImage from '../../assets/images/portfolio/townhouse-jakarta-wall-panel-walnut.jpg';

const title = 'Jasa Kayu Jabodetabek | Lantai, Decking, Tangga & Custom';
const description = 'Jasa kayu profesional untuk Jakarta, Bogor, Depok, Tangerang, Tangerang Selatan, dan Bekasi. Konsultasi, survei, produksi, dan pemasangan lantai kayu, decking, tangga, wall panel, ceiling, serta detail custom.';
const canonical = 'https://www.jasakayuprofesional.com/layanan/jasa-kayu-jabodetabek';
const areas = [
  ['Jakarta', 'Jakarta Selatan, Barat, Utara, Timur, dan Pusat untuk hunian, apartemen, kantor, serta ruang komersial.'],
  ['Bogor & Puncak', 'Villa, rumah, resort, dan area outdoor yang butuh material hangat serta detail tahan cuaca.'],
  ['Depok', 'Pengerjaan lantai, tangga, wall panel, dan built-in dengan survei berdasarkan jadwal proyek.'],
  ['Tangerang & Tangsel', 'BSD, Serpong, Bintaro, Pamulang, Ciputat, Pondok Aren, Gading Serpong, dan sekitarnya.'],
  ['Bekasi', 'Hunian, renovasi, dan ruang usaha dengan koordinasi akses serta pengiriman material yang terukur.'],
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Jasa Kayu Jabodetabek',
  serviceType: 'Pengerjaan kayu custom',
  description,
  provider: { '@type': 'Organization', name: 'Jasa Kayu Profesional', url: 'https://www.jasakayuprofesional.com/' },
  areaServed: areas.map(([name]) => ({ '@type': 'AdministrativeArea', name })),
  hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Layanan kayu Jabodetabek', itemListElement: ['Lantai kayu', 'Decking dan pergola', 'Tangga kayu', 'Wall panel dan ceiling', 'Built-in custom'].map((name) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name } })) },
  url: canonical,
};
---

<Layout title={title} description={description} canonical={canonical} image="/images/portfolio/deck-ulin-rancamaya-bogor/deck-ulin-rancamaya-bogor-1.jpg">
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <section class="relative overflow-hidden bg-[#17352a] pb-20 pt-32 text-[#fffdf7] sm:pb-28 sm:pt-44"><div class="absolute inset-0 opacity-25"><Image src={heroImage} alt="Deck kayu outdoor di area hunian" class="h-full w-full object-cover" width={1600} height={900} loading="eager" fetchpriority="high" /></div><div class="absolute inset-0 bg-gradient-to-r from-[#17352a] via-[#17352a]/90 to-[#17352a]/45" /><div class="section-shell relative grid gap-12 lg:grid-cols-[1fr_.7fr] lg:items-end"><div><p class="section-kicker text-[#e6c88f]">Area kerja · Jabodetabek</p><h1 class="display-title mt-5 max-w-5xl text-5xl sm:text-6xl lg:text-8xl">Pengerjaan kayu yang dekat dengan <em>proyek Anda.</em></h1><p class="mt-7 max-w-2xl text-base leading-7 text-white/75 sm:text-lg">Satu tim untuk membaca kondisi area, memilih material, dan mengerjakan detail kayu di Jakarta, Bogor, Depok, Tangerang, serta Bekasi.</p><div class="mt-9 flex flex-wrap gap-3"><a href="#kontak" class="btn-wood !bg-[#e6c88f] !text-[#17231d]">Kirim brief proyek <span aria-hidden="true">↗</span></a><a href="#area" class="inline-flex items-center rounded-full border border-white/35 px-5 py-3 text-xs font-extrabold uppercase tracking-[.12em] transition hover:bg-white hover:text-[#17352a]">Cek area kerja</a></div></div><div class="border-l border-white/25 pl-6 text-sm leading-7 text-white/70"><p class="text-[#e6c88f]">Mulai dari hal yang nyata</p><p class="mt-3">Foto area, ukuran kasar, lokasi, dan kebutuhan utama. Kami bantu menyusun langkah yang masuk akal sebelum survei dan estimasi.</p></div></div></section>
  <section id="area" class="bg-[#f4f2eb] py-20 sm:py-28"><div class="section-shell grid gap-12 lg:grid-cols-[.7fr_1.3fr] lg:items-start"><div><p class="section-kicker">Cakupan proyek</p><h2 class="display-title mt-5 text-5xl text-[#17231d] sm:text-6xl">Jabodetabek, dengan konteks yang <em>jelas.</em></h2><p class="mt-6 max-w-md text-sm leading-7 text-[#59645b]">Jarak memengaruhi jadwal, akses, dan logistik. Karena itu kami menyebut area kerja dengan jujur dan membahas kondisi lokasi sejak awal.</p></div><div class="grid gap-px overflow-hidden border border-[#17231d]/15 bg-[#17231d]/15 sm:grid-cols-2">{areas.map(([name, text], index) => <div class="bg-[#f4f2eb] p-7"><p class="text-[.62rem] font-extrabold uppercase tracking-[.14em] text-[#315443]">0{index + 1} · Area kerja</p><h3 class="mt-4 font-serif text-3xl font-semibold text-[#17231d]">{name}</h3><p class="mt-3 text-sm leading-7 text-[#59645b]">{text}</p></div>)}</div></div></section>
  <section class="bg-[#e7dfd0] py-20 sm:py-28"><div class="section-shell grid gap-10 lg:grid-cols-[.95fr_1.05fr] lg:items-center"><div class="overflow-hidden"><Image src={detailImage} alt="Detail wall panel kayu pada townhouse" width={1200} height={800} loading="lazy" format="webp" class="aspect-[4/3] w-full object-cover" /></div><div><p class="section-kicker">Scope pekerjaan</p><h2 class="display-title mt-5 text-5xl text-[#17231d] sm:text-6xl">Dari material sampai detail <em>terakhir.</em></h2><div class="mt-8 grid gap-3 sm:grid-cols-2">{['Lantai kayu solid dan engineered', 'Decking dan pergola outdoor', 'Tangga kayu custom', 'Wall panel dan ceiling', 'Furniture built-in', 'Finishing dan maintenance'].map((item, index) => <div class="border-t border-[#17231d]/20 pt-4 text-sm font-bold text-[#315443]"><span class="mr-3 text-[#9b7a44]">0{index + 1}</span>{item}</div>)}</div><a href="#kontak" class="btn-wood mt-9">Diskusikan kebutuhan <span aria-hidden="true">↗</span></a></div></div></section>
  <Contact />
  <Footer slot="footer" />
</Layout>
