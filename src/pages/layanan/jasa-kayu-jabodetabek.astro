---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import heroImage from '../../assets/images/portfolio/deck-ulin-rancamaya-bogor/deck-ulin-rancamaya-bogor-1.jpg';
import detailImage from '../../assets/images/portfolio/townhouse-jakarta-wall-panel-walnut.jpg';

const title = 'Jasa Kayu Jabodetabek | Lantai, Decking, Tangga & Custom';
const description = 'Jasa kayu untuk Jakarta, Bogor, Depok, Tangerang, Tangerang Selatan, dan Bekasi. Lantai kayu, decking, tangga, wall panel, ceiling, built-in, serta detail custom dengan scope yang dibaca dari kondisi proyek.';
const canonical = 'https://www.jasakayuprofesional.com/layanan/jasa-kayu-jabodetabek';
const areas = [
  { number: '01', name: 'Jakarta', text: 'Hunian, apartemen, kantor, hospitality, dan area komersial dengan koordinasi akses serta existing finish.', project: 'Deck Apartemen Dharmawangsa', href: '/portfolio/deck-apartemen-dharmawangsa' },
  { number: '02', name: 'Bogor & Puncak', text: 'Villa, rumah, resort, serta ruang outdoor yang membutuhkan pembacaan cuaca, drainase, dan maintenance.', project: 'Deck Ulin Rancamaya', href: '/portfolio/deck-ulin-rancamaya-bogor' },
  { number: '03', name: 'Tangerang & Tangsel', text: 'BSD, Serpong, Bintaro, Pamulang, Ciputat, Pondok Aren, dan area sekitar untuk interior maupun outdoor.', project: 'Tangga Modern BSD', href: '/portfolio/tangga-modern-bsd' },
  { number: '04', name: 'Jakarta Barat & Utara', text: 'Kebon Jeruk, PIK, dan area sekitarnya dengan kebutuhan hunian, commercial detail, dan pekerjaan custom.', project: 'Golf Mediterania PIK', href: '/portfolio/golf-mediterania-pik-jakut' },
  { number: '05', name: 'Depok & Bekasi', text: 'Pengerjaan dibahas berdasarkan lokasi, akses material, scope, kondisi existing, dan jadwal proyek.', project: 'Diskusikan lokasi', href: '#kontak' },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Jasa Kayu Jabodetabek',
  serviceType: 'Pengerjaan kayu custom',
  description,
  provider: { '@type': 'Organization', name: 'Jasa Kayu Profesional', url: 'https://www.jasakayuprofesional.com/' },
  areaServed: ['Jakarta','Bogor','Depok','Tangerang','Tangerang Selatan','Bekasi'].map((name) => ({ '@type': 'AdministrativeArea', name })),
  hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Layanan kayu Jabodetabek', itemListElement: ['Lantai kayu', 'Decking dan pergola', 'Tangga kayu', 'Wall panel dan ceiling', 'Built-in custom'].map((name) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name } })) },
  url: canonical,
};
---
<Layout title={title} description={description} canonical={canonical} image="/images/portfolio/deck-ulin-rancamaya-bogor/deck-ulin-rancamaya-bogor-1.jpg">
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <section class="relative min-h-[50rem] overflow-hidden bg-[#17352a] text-[#fffdf7] lg:min-h-[90vh]">
    <Image src={heroImage} alt="Deck kayu outdoor pada proyek Rancamaya, Bogor" width={1800} height={1100} loading="eager" fetchpriority="high" format="webp" class="absolute inset-0 h-full w-full object-cover opacity-60" />
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(10,31,23,.95)_0%,rgba(10,31,23,.76)_47%,rgba(10,31,23,.2)_100%)]"></div><div class="grid-lines absolute inset-0 opacity-25"></div>
    <div class="section-shell relative flex min-h-[50rem] flex-col justify-end pb-10 pt-36 lg:min-h-[90vh] lg:pb-14">
      <p class="reveal section-kicker text-[#e6c88f]">Area kerja · Jabodetabek</p>
      <h1 class="reveal display-title mt-6 max-w-6xl text-[clamp(4.5rem,10vw,9.5rem)]">Satu studio, konteks proyek yang <em>berbeda-beda.</em></h1>
      <div class="reveal mt-8 grid gap-8 border-t border-white/25 pt-6 lg:grid-cols-[1.25fr_.75fr] lg:items-end"><p class="max-w-2xl text-base leading-7 text-white/70 sm:text-lg sm:leading-8">Jakarta, Bogor, Depok, Tangerang, dan Bekasi punya tantangan akses, cuaca, jenis properti, serta existing condition yang berbeda. Kami membawa sistem kerja yang sama, lalu menyesuaikannya dengan lokasi.</p><a href="#kontak" class="group flex items-center justify-between border-b border-white/30 pb-3 text-[.66rem] font-extrabold uppercase tracking-[.13em] text-[#e6c88f] lg:justify-self-end lg:min-w-[15rem]">Kirim lokasi proyek <span class="text-xl transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true">↗</span></a></div>
      <div class="reveal mt-10 grid gap-px border border-white/15 bg-white/15 sm:grid-cols-2 lg:grid-cols-4">{[['Scope','Interior / Outdoor'],['Services','Floor / Deck / Stair / Wall'],['Approach','Brief → Survey → Scope'],['Coverage','Jabodetabek']].map(([a,b]) => <div class="bg-[#17352a]/70 p-4 backdrop-blur-sm"><p class="text-[.55rem] font-extrabold uppercase tracking-[.15em] text-white/40">{a}</p><p class="mt-2 text-sm font-bold text-white/90">{b}</p></div>)}</div>
    </div>
  </section>

  <section id="area" class="bg-[#f4f2eb] py-24 sm:py-32 lg:py-40"><div class="section-shell grid gap-12 lg:grid-cols-[.52fr_1.48fr]"><div class="reveal sticky-copy self-start"><p class="section-kicker">Project geography</p><h2 class="display-title mt-6 text-5xl text-[#17231d] sm:text-6xl">Lokasi tanpa bukti hanya menjadi <em>keyword.</em></h2><p class="mt-6 max-w-sm text-sm leading-7 text-[#68736a]">Kami menghubungkan area kerja ke proyek yang memang ada di arsip agar halaman lokasi tetap punya konteks nyata.</p></div><div class="reveal-stagger border-t border-[#17231d]/15">{areas.map((item) => <div class="grid gap-4 border-b border-[#17231d]/15 py-6 sm:grid-cols-[3rem_.65fr_1fr_auto] sm:items-start"><span class="text-[.58rem] font-extrabold uppercase tracking-[.15em] text-[#315443]">{item.number}</span><div><h3 class="font-serif text-3xl font-semibold leading-none tracking-[-.04em] text-[#17231d] sm:text-4xl">{item.name}</h3><p class="mt-3 text-sm leading-7 text-[#59645b]">{item.text}</p></div><a href={item.href} class="text-sm font-bold text-[#315443] sm:pt-2">{item.project}</a><a href={item.href} class="hidden h-11 w-11 items-center justify-center rounded-full border border-[#17231d]/20 text-lg text-[#315443] transition hover:bg-[#17231d] hover:text-white sm:flex" aria-label={`Buka ${item.project}`}>↗</a></div>)}</div></div></section>

  <section class="bg-[#e7dfd0] py-24 sm:py-32 lg:py-40"><div class="section-shell grid gap-12 lg:grid-cols-[1.05fr_.95fr] lg:items-center"><div class="reveal image-zoom overflow-hidden bg-[#d7c9b3]"><Image src={detailImage} alt="Detail wall panel kayu pada townhouse Jakarta" width={1300} height={1000} loading="lazy" format="webp" class="aspect-[4/3] w-full object-cover lg:aspect-[4/5]" /></div><div class="reveal lg:pl-6"><p class="section-kicker">Scope pekerjaan</p><h2 class="display-title mt-6 text-5xl text-[#17231d] sm:text-6xl lg:text-7xl">Dari material sampai detail <em>pertemuan.</em></h2><div class="mt-9 border-t border-[#17231d]/15">{['Lantai kayu solid dan engineered','Decking dan pergola outdoor','Tangga kayu custom','Wall panel dan ceiling','Furniture built-in dan detail custom','Finishing dan maintenance sesuai scope'].map((item,index) => <div class="grid grid-cols-[3rem_1fr] gap-4 border-b border-[#17231d]/15 py-4"><span class="text-[.58rem] font-extrabold uppercase tracking-[.14em] text-[#315443]">0{index+1}</span><p class="text-sm font-bold text-[#17231d]">{item}</p></div>)}</div><a href="#kontak" class="btn-wood mt-9">Diskusikan kebutuhan <span aria-hidden="true">↗</span></a></div></div></section>

  <section class="bg-[#10271e] py-24 text-white sm:py-32 lg:py-40"><div class="section-shell"><div class="grid gap-10 border-b border-white/15 pb-10 lg:grid-cols-[.52fr_1.48fr] lg:items-end"><p class="reveal section-kicker text-[#e6c88f]">Sebelum survei</p><h2 class="reveal display-title text-5xl sm:text-6xl lg:text-8xl">Empat hal yang mempercepat diskusi <em>awal.</em></h2></div><div class="reveal-stagger mt-4 grid gap-px border border-white/15 bg-white/15 sm:grid-cols-2 lg:grid-cols-4">{[['01','Foto area','Beberapa sudut, termasuk titik pertemuan dengan material lain.'],['02','Ukuran kasar','Panjang, lebar, tinggi, atau luasan perkiraan untuk membaca skala.'],['03','Lokasi','Kota, area, tipe properti, serta catatan akses jika ada.'],['04','Kebutuhan','Masalah yang ingin diselesaikan, target visual, dan prioritas pemakaian.']].map(([n,h,t]) => <div class="bg-[#10271e] p-7"><p class="text-[.58rem] font-extrabold uppercase tracking-[.15em] text-[#e6c88f]">{n}</p><h3 class="mt-6 font-serif text-4xl font-semibold tracking-[-.045em]">{h}</h3><p class="mt-5 text-sm leading-7 text-white/60">{t}</p></div>)}</div></div></section>

  <Contact />
  <Footer slot="footer" />
</Layout>
