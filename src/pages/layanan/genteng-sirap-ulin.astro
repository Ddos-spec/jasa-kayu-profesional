---
import Layout from '../../layouts/Layout.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';

const title = 'Jasa Pasang Genteng Sirap Ulin Jabodetabek | Jasa Kayu Profesional';
const description = 'Perencanaan dan pemasangan genteng sirap ulin untuk rumah, villa, pavilion, dan bangunan tropis. Kemiringan, overlap, ventilasi, underlayer, flashing, dan detail tepi dibahas sebagai satu sistem atap.';
const canonical = 'https://www.jasakayuprofesional.com/layanan/genteng-sirap-ulin';
const serviceSchema = {
  '@context': 'https://schema.org', '@type': 'Service', name: 'Jasa Pasang Genteng Sirap Ulin', serviceType: 'Pemasangan atap sirap kayu ulin', description,
  provider: { '@type': 'Organization', name: 'Jasa Kayu Profesional', url: 'https://www.jasakayuprofesional.com/' },
  areaServed: ['Jakarta','Bogor','Depok','Tangerang','Bekasi'].map((name) => ({ '@type': 'AdministrativeArea', name })), url: canonical,
};
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [
    { '@type': 'Question', name: 'Apa yang perlu dicek sebelum memasang sirap ulin?', acceptedAnswer: { '@type': 'Answer', text: 'Kemiringan atap, kondisi struktur, pola overlap, underlayer, ventilasi, flashing, titik talang, ridge, serta akses pemasangan perlu diperiksa sebelum menentukan detail.' } },
    { '@type': 'Question', name: 'Bisa konsultasi dari foto sebelum survei?', acceptedAnswer: { '@type': 'Answer', text: 'Bisa. Foto bangunan, gambar atap bila tersedia, ukuran perkiraan, lokasi, dan kondisi struktur dapat digunakan untuk diskusi awal sebelum survei lapangan.' } },
  ],
};
const layers = [
  ['01','Sirap','Lapisan kayu terlihat yang membentuk ritme, overlap, dan karakter atap.'],
  ['02','Underlayer','Lapisan pendukung untuk membantu pengelolaan air dan menjaga sistem bawah tetap terlindungi.'],
  ['03','Batten / reng','Bidang fixing yang menentukan jarak, alignment, dan konsistensi pola sirap.'],
  ['04','Roof structure','Struktur utama yang harus stabil, lurus, dan sesuai dengan beban serta geometri atap.'],
];
const process = [
  ['01','Read the roof','Cek pitch, struktur, ridge, valley, talang, penetrasi atap, akses, serta arah limpasan air.'],
  ['02','Set the module','Dimensi sirap, overlap, exposure, garis awal, edge detail, dan pola pertemuan disusun sebelum pemasangan.'],
  ['03','Protect the junctions','Flashing, valley, ridge, penetrasi, dan titik peralihan menjadi prioritas karena di situlah air paling mudah menemukan jalur.'],
  ['04','Install & inspect','Pemasangan dikontrol pada alignment, fixing, overlap, ventilasi, detail tepi, dan akses maintenance.'],
];
---
<Layout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="relative min-h-[50rem] overflow-hidden bg-[#1d1711] text-[#fffdf7] lg:min-h-[92vh]">
    <div class="absolute inset-0 opacity-60" style="background-image:radial-gradient(circle at 78% 22%,rgba(230,200,143,.18),transparent 28%),linear-gradient(135deg,rgba(255,255,255,.025) 25%,transparent 25%,transparent 50%,rgba(255,255,255,.025) 50%,rgba(255,255,255,.025) 75%,transparent 75%);background-size:auto,72px 72px"></div>
    <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-[#120e0a] to-transparent"></div>
    <div class="section-shell relative flex min-h-[50rem] flex-col justify-end pb-10 pt-36 lg:min-h-[92vh] lg:pb-14">
      <p class="reveal section-kicker text-[#e6c88f]">Timber roof · Tropical envelope</p>
      <h1 class="reveal display-title mt-7 max-w-6xl text-[clamp(4.5rem,11vw,10rem)]">Atap yang dibentuk oleh <em>kayu dan cuaca.</em></h1>
      <div class="reveal mt-8 grid gap-8 border-t border-white/20 pt-6 lg:grid-cols-[1.3fr_.7fr] lg:items-end"><p class="max-w-2xl text-base leading-7 text-white/68 sm:text-lg sm:leading-8">Sirap ulin bukan sekadar penutup atap bernuansa tradisional. Performanya bergantung pada pitch, overlap, jalur air, ventilasi, underlayer, fixing, dan detail junction yang tidak terlihat dari bawah.</p><a href="#kontak" class="group flex items-center justify-between border-b border-white/25 pb-3 text-[.66rem] font-extrabold uppercase tracking-[.13em] text-[#e6c88f] lg:justify-self-end lg:min-w-[15rem]">Bahas kondisi atap <span class="text-xl transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true">↗</span></a></div>
      <div class="reveal mt-10 grid gap-px border border-white/15 bg-white/15 sm:grid-cols-2 lg:grid-cols-4">{[['Material','Ulin / sesuai spesifikasi'],['System','Overlap / Underlayer'],['Critical detail','Ridge / Valley / Flashing'],['Area','Jabodetabek']].map(([a,b]) => <div class="bg-[#1d1711]/75 p-4 backdrop-blur-sm"><p class="text-[.55rem] font-extrabold uppercase tracking-[.15em] text-white/40">{a}</p><p class="mt-2 text-sm font-bold text-white/88">{b}</p></div>)}</div>
    </div>
  </section>

  <section class="bg-[#f4f2eb] py-24 sm:py-32 lg:py-40">
    <div class="section-shell grid gap-12 lg:grid-cols-[.52fr_1.48fr]"><div class="reveal sticky-copy self-start"><p class="section-kicker">Roof anatomy</p><p class="mt-6 max-w-xs text-sm leading-7 text-[#68736a]">Yang terlihat dari luar hanya satu lapisan. Sistem yang baik justru ditentukan oleh bagaimana lapisan itu ditopang dan bagaimana air diarahkan.</p></div><div><p class="reveal font-serif text-[clamp(3rem,6vw,6.5rem)] font-semibold leading-[.9] tracking-[-.055em] text-[#17231d]">Atap kayu harus tetap indah saat dilihat, dan tetap logis saat <em>hujan turun.</em></p><div class="reveal-stagger mt-12 border-t border-[#17231d]/15">{layers.map(([n,h,t]) => <div class="grid gap-4 border-b border-[#17231d]/15 py-6 sm:grid-cols-[3rem_.65fr_1.35fr] sm:items-start"><span class="text-[.58rem] font-extrabold uppercase tracking-[.15em] text-[#315443]">{n}</span><h2 class="font-serif text-3xl font-semibold leading-none tracking-[-.04em] text-[#17231d] sm:text-4xl">{h}</h2><p class="text-sm leading-7 text-[#59645b]">{t}</p></div>)}</div></div></div>
  </section>

  <section class="bg-[#e7dfd0] py-24 sm:py-32 lg:py-40">
    <div class="section-shell">
      <div class="grid gap-10 border-b border-[#17231d]/15 pb-10 lg:grid-cols-[.52fr_1.48fr] lg:items-end"><p class="reveal section-kicker">Water is the brief</p><div class="reveal"><h2 class="display-title text-5xl text-[#17231d] sm:text-6xl lg:text-8xl">Junction lebih penting daripada bidang yang <em>mudah.</em></h2><p class="mt-6 max-w-2xl text-sm leading-7 text-[#59645b]">Ridge, valley, pertemuan dinding, talang, skylight, pipa, dan perubahan bidang adalah area yang perlu diselesaikan sebelum estetika pola sirap dianggap selesai.</p></div></div>
      <div class="reveal-stagger mt-10 grid gap-px border border-[#17231d]/15 bg-[#17231d]/15 sm:grid-cols-2 lg:grid-cols-4">{[['Ridge','Titik puncak dan pertemuan dua bidang.'],['Valley','Jalur konsentrasi aliran air antar bidang.'],['Flashing','Perlindungan pada sambungan material dan penetrasi.'],['Eave','Tepi bawah, drip line, talang, dan ventilasi.']].map(([h,t],i) => <div class="bg-[#e7dfd0] p-7"><p class="text-[.58rem] font-extrabold uppercase tracking-[.15em] text-[#315443]">0{i+1}</p><h3 class="mt-6 font-serif text-4xl font-semibold tracking-[-.045em] text-[#17231d]">{h}</h3><p class="mt-5 text-sm leading-7 text-[#59645b]">{t}</p></div>)}</div>
    </div>
  </section>

  <section class="bg-[#10271e] py-24 text-white sm:py-32 lg:py-40"><div class="section-shell"><div class="grid gap-10 border-b border-white/15 pb-10 lg:grid-cols-[.52fr_1.48fr] lg:items-end"><p class="reveal section-kicker text-[#e6c88f]">Urutan kerja</p><h2 class="reveal display-title text-5xl sm:text-6xl lg:text-8xl">Dari geometri atap ke <em>garis terakhir.</em></h2></div><ol class="reveal-stagger mt-4">{process.map(([n,h,t]) => <li class="grid gap-4 border-b border-white/15 py-7 sm:grid-cols-[4rem_.7fr_1.3fr]"><span class="text-[.6rem] font-extrabold uppercase tracking-[.15em] text-[#e6c88f]">{n}</span><h3 class="font-serif text-3xl font-semibold leading-none tracking-[-.04em] sm:text-4xl">{h}</h3><p class="max-w-2xl text-sm leading-7 text-white/60">{t}</p></li>)}</ol></div></section>

  <section class="bg-[#f4f2eb] py-20 sm:py-28"><div class="section-shell grid gap-8 border-t border-[#17231d]/15 pt-8 sm:grid-cols-[1fr_auto] sm:items-end"><p class="max-w-4xl font-serif text-[clamp(2.7rem,5vw,5.4rem)] font-semibold leading-[.9] tracking-[-.05em] text-[#17231d]">Punya gambar atap atau foto bangunan? Itu lebih berguna untuk diskusi awal daripada memilih sirap dari katalog.</p><a href="#kontak" class="btn-wood">Kirim kondisi atap <span aria-hidden="true">↗</span></a></div></section>
  <Contact />
  <Footer slot="footer" />
</Layout>
