---
import { getCollection } from 'astro:content';
const testimonials = (await getCollection('testimonial')).filter(({ data }) => data.featured).slice(0, 4);
---
<section id="testimoni" class="section-anchor bg-[#f4f2eb] py-24 sm:py-32 lg:py-40">
  <div class="section-shell">
    <div class="grid gap-10 border-b border-[#17231d]/15 pb-10 lg:grid-cols-[.52fr_1.48fr] lg:items-end">
      <div class="reveal"><p class="section-kicker">Dari klien</p></div>
      <div class="reveal"><h2 class="display-title max-w-5xl text-5xl text-[#17231d] sm:text-6xl lg:text-8xl">Bukan testimonial massal.<br /><em>Beberapa suara yang relevan.</em></h2><p class="mt-7 max-w-2xl text-sm leading-7 text-[#59645b]">Kami lebih memilih sedikit testimoni yang punya konteks daripada memenuhi halaman dengan kutipan generik yang sulit diverifikasi.</p></div>
    </div>

    <div class="reveal-stagger mt-4 border-t border-[#17231d]/15">
      {testimonials.map((item, index) => (
        <article class="grid gap-6 border-b border-[#17231d]/15 py-8 sm:grid-cols-[3.5rem_1.35fr_.65fr] sm:items-start sm:py-10">
          <span class="text-[.58rem] font-extrabold uppercase tracking-[.15em] text-[#315443]">0{index + 1}</span>
          <blockquote class="max-w-4xl font-serif text-[clamp(2rem,4vw,4.2rem)] font-semibold leading-[.98] tracking-[-.045em] text-[#17231d]">“{item.data.content}”</blockquote>
          <div class="sm:justify-self-end sm:text-right"><p class="text-sm font-extrabold text-[#17231d]">{item.data.name}</p><p class="mt-1 text-xs leading-5 text-[#647067]">{item.data.role ?? item.data.company ?? 'Klien Jasa Kayu Profesional'}</p></div>
        </article>
      ))}
    </div>
  </div>
</section>
