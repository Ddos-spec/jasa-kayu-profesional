---
import { getCollection } from 'astro:content';
const testimonials = (await getCollection('testimonial')).filter(({ data }) => data.featured).slice(0, 3);
---
<section id="testimoni" class="section-anchor bg-[#f4f2eb] py-24 sm:py-32">
  <div class="section-shell">
    <div class="flex flex-col justify-between gap-6 border-b border-[#17231d]/15 pb-10 sm:flex-row sm:items-end">
      <div class="reveal"><p class="section-kicker">Dari klien</p><h2 class="display-title mt-5 text-5xl text-[#17231d] sm:text-6xl">Ruang jadi lebih terasa<br /><em>seperti milik sendiri.</em></h2></div>
      <p class="reveal max-w-sm text-sm leading-6 text-[#566158]">Cerita nyata dari proyek yang membutuhkan ketelitian, komunikasi, dan hasil yang pantas dirawat.</p>
    </div>
    <div class="mt-10 grid gap-5 lg:grid-cols-3">
      {testimonials.map((item, index) => (
        <article class="reveal art-card flex min-h-[18rem] flex-col justify-between p-7 sm:p-8">
          <p class="font-serif text-3xl leading-[1.06] tracking-[-.035em] text-[#17231d]">“{item.data.content}”</p>
          <div class="mt-8 flex items-end justify-between gap-4 border-t border-[#17231d]/15 pt-4"><div><p class="text-sm font-extrabold text-[#17231d]">{item.data.name}</p><p class="mt-1 text-xs text-[#647067]">{item.data.role ?? item.data.company ?? 'Klien Jasa Kayu Profesional'}</p></div><span class="font-serif text-3xl text-[#987755]">0{index + 1}</span></div>
        </article>
      ))}
    </div>
  </div>
</section>
