---
import { Image } from 'astro:assets';
import flooringImage from '../assets/images/portfolio/villa-puncak-lantai-jati-solid.jpg';
import wallImage from '../assets/images/portfolio/townhouse-jakarta-wall-panel-walnut.jpg';
import deckingImage from '../assets/images/portfolio/deck-ulin-rancamaya-bogor/deck-ulin-rancamaya-bogor-1.jpg';
import ceilingImage from '../assets/images/portfolio/hotel-boutique-bandung-lobby-ceiling.jpg';
import stairsImage from '../assets/images/portfolio/penthouse-scbd-spiral-staircase.jpg';
import customImage from '../assets/images/portfolio/rumah-wagub-dki-1.jpg';

const services = [
  { number: '01', label: 'Interior', title: 'Lantai kayu', description: 'Material, pola, level pemasangan, kelembapan subfloor, transisi pintu, dan finishing dibaca sebagai satu sistem agar hasilnya rapi dari sudut mana pun.', href: '/layanan/lantai-kayu-premium', image: flooringImage, details: ['Jati / Merbau / engineered', 'Plank / herringbone / custom', 'Subfloor & moisture check'] },
  { number: '02', label: 'Interior', title: 'Wall panel & ceiling', description: 'Bidang dinding dan plafon dengan proporsi, sambungan, arah serat, akses service, serta permainan cahaya yang membuat ruang terasa selesai.', href: '/layanan/dinding-kayu-dan-wall-cladding', image: wallImage, details: ['Flat / slatted / relief', 'Corner & opening detail', 'Lighting / electrical coordination'] },
  { number: '03', label: 'Outdoor', title: 'Decking & pergola', description: 'Area luar dengan drainase, sirkulasi bawah, substructure, fixing, dan finishing yang dipikirkan untuk menghadapi ritme cuaca tropis.', href: '/layanan/pergola-decking-outdoor', image: deckingImage, details: ['Ulin / Bengkirai', 'Drainage & ventilation', 'Visible / hidden fixing'] },
  { number: '04', label: 'Detail', title: 'Tangga kayu', description: 'Setiap pijakan, nosing, riser, railing, dan pertemuan struktur dibuat untuk terasa mantap, proporsional, dan menyatu dengan arsitektur rumah.', href: '/layanan/tangga-kayu-artistik', image: stairsImage, details: ['Tread / riser / cladding', 'Concrete / steel interface', 'Nosing & railing'] },
  { number: '05', label: 'Interior', title: 'Lambersering', description: 'Ceiling dan pelapis bidang yang mengangkat tekstur kayu sambil tetap mempertimbangkan modul, level, lighting, HVAC, dan access panel.', href: '/layanan/plafon-kayu-ceiling', image: ceilingImage, details: ['Lambersering / slat / panel', 'Lighting / HVAC grid', 'Rangka & service access'] },
  { number: '06', label: 'Custom', title: 'Pengerjaan spesifik', description: 'Untuk detail yang tidak bisa diselesaikan produk jadi: built-in, feature element, storage, dan kebutuhan custom yang harus menyesuaikan kondisi lapangan.', href: '#kontak', image: customImage, details: ['Built-in & storage', 'Feature element', 'Site-specific fabrication'] },
];
---
<section id="layanan" class="section-anchor bg-[#f4f2eb] py-24 sm:py-32 lg:py-40">
  <div class="section-shell">
    <div class="grid gap-10 border-b border-[#17231d]/15 pb-12 lg:grid-cols-[1fr_.8fr] lg:items-end">
      <div class="reveal">
        <p class="section-kicker">Lingkup kerja</p>
        <h2 class="display-title text-balance mt-5 max-w-3xl text-5xl text-[#17231d] sm:text-6xl lg:text-7xl">Dikerjakan dengan detail,<br /><em>dibuat untuk dipakai.</em></h2>
      </div>
      <div class="reveal"><p class="max-w-xl text-base leading-7 text-[#566158] sm:text-lg">Setiap proyek dimulai dari fungsi ruang, karakter material, kondisi lapangan, dan bagaimana hasilnya akan dirawat. Bukan memilih kayu dulu lalu mencari alasan untuk memakainya.</p><p class="mt-5 max-w-xl text-sm leading-7 text-[#68736a]">Scope kami tidak berhenti pada pemasangan permukaan: kondisi dasar, sambungan, akses, koordinasi elemen lain, dan handover ikut dibahas supaya keputusan tidak muncul terlambat di lapangan.</p></div>
    </div>
    <div class="grid divide-y divide-[#17231d]/15 lg:grid-cols-2 lg:divide-x lg:divide-y-0">
      {services.map((service, index) => (
        <a href={service.href} class={`group relative block overflow-hidden py-8 ${index % 2 === 0 ? 'lg:pr-8' : 'lg:pl-8'} ${index > 1 ? 'lg:border-t lg:border-[#17231d]/15 lg:pt-9' : ''}`}>
          <div class="grid gap-6 sm:grid-cols-[10.5rem_1fr] sm:items-start">
            <div class="image-zoom relative aspect-[4/3] overflow-hidden bg-[#ded6c7] sm:aspect-square">
              <Image src={service.image} alt={`Pekerjaan ${service.title} oleh Jasa Kayu Profesional`} width={480} height={480} format="webp" loading="lazy" class="h-full w-full object-cover" />
              <span class="absolute left-3 top-3 rounded-full bg-[#f4f2eb]/90 px-2.5 py-1 text-[0.56rem] font-extrabold tracking-[.13em] text-[#17231d] backdrop-blur-sm">{service.number}</span>
            </div>
            <div>
              <p class="text-[0.62rem] font-extrabold uppercase tracking-[.14em] text-[#6c766d]">{service.label}</p>
              <h3 class="mt-2 font-serif text-3xl font-semibold tracking-[-.035em] text-[#17231d] sm:text-[2.1rem]">{service.title}</h3>
              <p class="mt-3 max-w-md text-sm leading-7 text-[#59645b]">{service.description}</p>
              <ul class="mt-5 space-y-2 border-t border-[#17231d]/15 pt-4 text-[.62rem] font-extrabold uppercase tracking-[.09em] text-[#315443]">{service.details.map((detail) => <li class="flex items-center gap-2"><span aria-hidden="true">—</span>{detail}</li>)}</ul>
              <span class="mt-6 inline-flex items-center gap-2 text-[0.67rem] font-extrabold uppercase tracking-[.12em] text-[#315443]">Lihat pendekatan lengkap <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span></span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="reveal mt-14 grid gap-px border border-[#17231d]/15 bg-[#17231d]/15 sm:grid-cols-2 lg:grid-cols-4">
      {[['01','Survey & kondisi','Ukuran, bidang dasar, kelembapan, akses, struktur, dan pertemuan material diperiksa sebelum keputusan teknis.'],['02','Detail resolution','Modul, arah serat, sambungan, edge, fixing, transisi, dan koordinasi service diselesaikan sebelum produksi.'],['03','Fabrication & install','Material diseleksi dan difabrikasi sesuai scope, lalu pemasangan mengikuti urutan yang cocok dengan kondisi site.'],['04','Handover & care','Pemeriksaan akhir dan catatan perawatan disampaikan supaya hasil tetap masuk akal setelah proyek mulai dipakai.']].map(([n,h,t]) => <article class="bg-[#f4f2eb] p-7 sm:p-8"><p class="text-[.58rem] font-extrabold uppercase tracking-[.15em] text-[#315443]">{n}</p><h3 class="mt-6 font-serif text-3xl font-semibold leading-[.95] tracking-[-.04em] text-[#17231d]">{h}</h3><p class="mt-5 text-sm leading-7 text-[#59645b]">{t}</p></article>)}
    </div>
  </div>
</section>
