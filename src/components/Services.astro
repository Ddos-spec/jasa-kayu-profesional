---
import { Image } from 'astro:assets';
import flooringImage from '../assets/images/portfolio/villa-puncak-lantai-jati-solid.jpg';
import wallImage from '../assets/images/portfolio/townhouse-jakarta-wall-panel-walnut.jpg';
import deckingImage from '../assets/images/portfolio/deck-ulin-rancamaya-bogor/deck-ulin-rancamaya-bogor-1.jpg';
import ceilingImage from '../assets/images/portfolio/hotel-boutique-bandung-lobby-ceiling.jpg';
import stairsImage from '../assets/images/portfolio/penthouse-scbd-spiral-staircase.jpg';
import customImage from '../assets/images/portfolio/rumah-wagub-dki-1.jpg';

const services = [
  { number: '01', label: 'Interior', title: 'Lantai kayu', description: 'Material, pola, dan level pemasangan dipikirkan sebagai satu sistem agar hasilnya rapi dari sudut mana pun.', href: '/layanan/lantai-kayu-premium', image: flooringImage },
  { number: '02', label: 'Interior', title: 'Wall panel & ceiling', description: 'Bidang dinding dan plafon dengan proporsi, sambungan, serta permainan cahaya yang membuat ruang terasa selesai.', href: '/layanan/dinding-kayu-dan-wall-cladding', image: wallImage },
  { number: '03', label: 'Outdoor', title: 'Decking & pergola', description: 'Area luar yang hangat, memiliki drainase yang terukur, serta siap menghadapi ritme cuaca tropis.', href: '/layanan/pergola-decking-outdoor', image: deckingImage },
  { number: '04', label: 'Detail', title: 'Tangga kayu', description: 'Setiap pijakan dibuat untuk terasa mantap, proporsional, dan menyatu dengan bahasa arsitektur rumah.', href: '/layanan/tangga-kayu-artistik', image: stairsImage },
  { number: '05', label: 'Interior', title: 'Lambersering', description: 'Ceiling dan pelapis bidang yang mengangkat tekstur kayu tanpa membuat ruang terasa berat.', href: '/layanan/plafon-kayu-ceiling', image: ceilingImage },
  { number: '06', label: 'Custom', title: 'Pengerjaan spesifik', description: 'Untuk detail yang tidak bisa diselesaikan produk jadi: konsultasi material sampai eksekusi di lapangan.', href: '#kontak', image: customImage },
];
---
<section id="layanan" class="section-anchor bg-[#f4f2eb] py-24 sm:py-32">
  <div class="section-shell">
    <div class="grid gap-10 border-b border-[#17231d]/15 pb-12 lg:grid-cols-[1fr_.8fr] lg:items-end">
      <div class="reveal">
        <p class="section-kicker">Lingkup kerja</p>
        <h2 class="display-title text-balance mt-5 max-w-3xl text-5xl text-[#17231d] sm:text-6xl lg:text-7xl">Dikerjakan dengan detail,<br /><em>dibuat untuk dipakai.</em></h2>
      </div>
      <p class="reveal max-w-xl text-base leading-7 text-[#566158] sm:text-lg">Setiap proyek dimulai dari fungsi ruang, karakter material, dan kondisi lapangan. Bukan memilih kayu dulu lalu mencari alasan untuk memakainya.</p>
    </div>
    <div class="grid divide-y divide-[#17231d]/15 lg:grid-cols-2 lg:divide-x lg:divide-y-0">
      {services.map((service, index) => (
        <a href={service.href} class={`group relative block overflow-hidden py-7 ${index % 2 === 0 ? 'lg:pr-8' : 'lg:pl-8'} ${index > 1 ? 'lg:border-t lg:border-[#17231d]/15 lg:pt-8' : ''}`}>
          <div class="grid gap-5 sm:grid-cols-[9.5rem_1fr] sm:items-center">
            <div class="image-zoom relative aspect-[4/3] overflow-hidden bg-[#ded6c7] sm:aspect-square">
              <Image src={service.image} alt={`Pekerjaan ${service.title} oleh Jasa Kayu Profesional`} width={420} height={420} format="webp" loading="lazy" class="h-full w-full object-cover" />
              <span class="absolute left-3 top-3 rounded-full bg-[#f4f2eb]/90 px-2.5 py-1 text-[0.56rem] font-extrabold tracking-[.13em] text-[#17231d] backdrop-blur-sm">{service.number}</span>
            </div>
            <div>
              <p class="text-[0.62rem] font-extrabold uppercase tracking-[.14em] text-[#6c766d]">{service.label}</p>
              <h3 class="mt-2 font-serif text-3xl font-semibold tracking-[-.035em] text-[#17231d] sm:text-[2.1rem]">{service.title}</h3>
              <p class="mt-3 max-w-md text-sm leading-6 text-[#59645b]">{service.description}</p>
              <span class="mt-5 inline-flex items-center gap-2 text-[0.67rem] font-extrabold uppercase tracking-[.12em] text-[#315443]">Lihat pendekatan <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span></span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
