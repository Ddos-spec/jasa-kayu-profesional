---
const whatsappNumber = '6281283135295';
const formScript = `
  const form = document.getElementById('contact-form');
  const feedback = document.getElementById('form-feedback');
  const serviceLabels = {
    lantai_kayu: 'Lantai kayu',
    wall_panel_ceiling: 'Wall panel atau ceiling',
    decking_pergola: 'Decking atau pergola',
    tangga_kayu: 'Tangga kayu',
    detail_custom: 'Detail custom'
  };
  const activateForm = ({ service, location, projectSummary } = {}) => {
    if (!form) return { status: 'unavailable' };
    form.scrollIntoView({ behavior: 'smooth', block: 'center' });
    if (service && serviceLabels[service]) form.elements.layanan.value = serviceLabels[service];
    if (location) form.elements.lokasi.value = location;
    if (projectSummary) form.elements.deskripsi.value = projectSummary;
    feedback.textContent = 'Brief konsultasi sudah siap untuk Anda cek dan lengkapi sebelum dikirim.';
    feedback.className = 'mt-4 text-sm text-[#e6c88f]';
    form.elements.nama.focus({ preventScroll: true });
    return { status: 'ready_for_review', nextStep: 'User reviews the visible form and manually sends the WhatsApp brief.' };
  };
  if (document.modelContext?.registerTool) {
    document.modelContext.registerTool({
      name: 'prepareWoodworkConsultation',
      description: 'Visibly opens the non-binding woodwork consultation form and optionally pre-fills project details. It never sends a message or commits a booking.',
      inputSchema: {
        type: 'object',
        properties: {
          service: { type: 'string', enum: Object.keys(serviceLabels), description: 'The type of woodwork requested.' },
          location: { type: 'string', maxLength: 80, description: 'Project city or area only.' },
          projectSummary: { type: 'string', maxLength: 500, description: 'Short non-sensitive description of the requested work.' }
        },
        additionalProperties: false
      },
      execute: async (input) => activateForm(input)
    }).catch(() => {});
  }
  window.addEventListener('toolactivated', (event) => {
    if (event.toolName === 'requestWoodworkConsultation') activateForm();
  });
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    let valid = true;
    form.querySelectorAll('[required]').forEach((field) => {
      const validField = field.checkValidity() && field.value.trim();
      field.classList.toggle('border-red-500', !validField);
      valid &&= Boolean(validField);
    });
    if (!valid) { feedback.textContent = 'Mohon lengkapi kolom yang ditandai sebelum melanjutkan.'; feedback.className = 'mt-4 text-sm text-red-700'; return; }
    const data = new FormData(form);
    const message = [
      'Halo Jasa Kayu Profesional, saya ingin konsultasi proyek.', '',
      'Nama: ' + data.get('nama'),
      'WhatsApp: ' + data.get('whatsapp'),
      'Kebutuhan: ' + data.get('layanan'),
      'Lokasi: ' + data.get('lokasi'),
      'Catatan: ' + (data.get('deskripsi') || '-')
    ].join('\\n');
    feedback.textContent = 'Mengarahkan Anda ke WhatsApp dengan brief proyek yang sudah terisi.';
    feedback.className = 'mt-4 text-sm text-[#315443]';
    const url = 'https://wa.me/${whatsappNumber}?text=' + encodeURIComponent(message);
    window.open(url, '_blank', 'noopener,noreferrer') || (window.location.href = url);
  });
`;
---
<section id="kontak" class="section-anchor bg-[#17231d] py-24 text-[#fffdf7] sm:py-32">
  <div class="section-shell grid gap-12 lg:grid-cols-[.78fr_1.22fr] lg:gap-20">
    <div class="reveal"><p class="section-kicker text-[#e6c88f]">Mari mulai</p><h2 class="display-title mt-5 text-5xl sm:text-6xl lg:text-7xl">Bawa ide Anda.<br /><em>Kita rapikan arahnya.</em></h2><p class="mt-7 max-w-md text-base leading-7 text-white/70">Kirim brief singkat dulu. Foto area dan ukuran kasar sering kali sudah cukup untuk memulai percakapan yang tepat.</p><div class="mt-10 space-y-4 border-t border-white/20 pt-6 text-sm"><a href="https://wa.me/6281283135295" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between border-b border-white/15 pb-4 font-bold hover:text-[#e6c88f]"><span>WhatsApp</span><span>+62 812 8313 5295 ↗</span></a><a href="mailto:info@jasakayuprofesional.com" class="flex items-center justify-between border-b border-white/15 pb-4 font-bold hover:text-[#e6c88f]"><span>Email</span><span>info@jasakayuprofesional.com ↗</span></a></div></div>
    <form id="contact-form" class="reveal border border-white/20 bg-white/[.06] p-6 backdrop-blur-sm sm:p-10" novalidate toolname="requestWoodworkConsultation" tooldescription="Prepare a visible, non-binding consultation brief for a woodwork project. The user reviews the form and manually opens WhatsApp; no booking, quote, or message is sent automatically.">
      <div class="grid gap-5 sm:grid-cols-2"><label class="text-sm font-bold">Nama<input id="nama" name="nama" required maxlength="80" autocomplete="name" toolparamdescription="Full name of the person requesting a consultation." placeholder="Nama Anda" class="mt-2 w-full border-b border-white/30 bg-transparent px-0 py-3 text-white placeholder:text-white/45 focus:border-[#e6c88f] focus:outline-none" /></label><label class="text-sm font-bold">WhatsApp<input id="whatsapp" name="whatsapp" required maxlength="24" type="tel" inputmode="tel" autocomplete="tel" toolparamdescription="WhatsApp number for the user to continue the visible consultation." placeholder="08xxxxxxxxxx" class="mt-2 w-full border-b border-white/30 bg-transparent px-0 py-3 text-white placeholder:text-white/45 focus:border-[#e6c88f] focus:outline-none" /></label></div>
      <div class="mt-7 grid gap-5 sm:grid-cols-2"><label class="text-sm font-bold">Kebutuhan<select id="layanan" name="layanan" required toolparamdescription="The woodwork service the user wants to discuss." class="mt-2 w-full border-b border-white/30 bg-[#17231d] px-0 py-3 text-white focus:border-[#e6c88f] focus:outline-none"><option value="">Pilih kebutuhan</option><option>Lantai kayu</option><option>Wall panel atau ceiling</option><option>Decking atau pergola</option><option>Tangga kayu</option><option>Detail custom</option></select></label><label class="text-sm font-bold">Lokasi proyek<input id="lokasi" name="lokasi" required maxlength="80" toolparamdescription="Project city or area, for example Jakarta Selatan." placeholder="Contoh: Jakarta Selatan" class="mt-2 w-full border-b border-white/30 bg-transparent px-0 py-3 text-white placeholder:text-white/45 focus:border-[#e6c88f] focus:outline-none" /></label></div>
      <label class="mt-7 block text-sm font-bold">Ceritakan singkat kebutuhan Anda<textarea id="deskripsi" name="deskripsi" rows="4" maxlength="500" toolparamdescription="Optional short description of the scope, rough dimensions, or material preference. Do not include sensitive personal information." placeholder="Contoh: decking balkon apartemen, ukuran kira-kira 12 m²" class="mt-2 w-full resize-none border-b border-white/30 bg-transparent px-0 py-3 text-white placeholder:text-white/45 focus:border-[#e6c88f] focus:outline-none"></textarea></label>
      <button type="submit" class="btn-wood mt-8 w-full !bg-[#e6c88f] !text-[#17231d] hover:!bg-[#fffdf7]">Kirim brief lewat WhatsApp <span aria-hidden="true">↗</span></button><p id="form-feedback" class="mt-4 text-sm text-white/65" aria-live="polite">Tidak ada komitmen. Anda akan melanjutkan langsung ke WhatsApp.</p>
    </form>
  </div>
  <script type="module" is:inline set:html={formScript} />
</section>
