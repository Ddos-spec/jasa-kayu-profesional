---
import { Picture } from 'astro:assets';
import heroImage from '../assets/images/portfolio/deck-ulin-rancamaya-bogor/deck-ulin-rancamaya-bogor-1.jpg';
---
<section id="hero" class="relative min-h-[45rem] overflow-hidden bg-[#17231d] text-[#fffdf7] lg:min-h-[48rem]">
  <Picture
    src={heroImage}
    alt="Deck kayu outdoor di hunian Jakarta"
    widths={[640, 960, 1280, 1600]}
    sizes="100vw"
    formats={['avif', 'webp']}
    quality="low"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 h-full w-full object-cover opacity-75"
  />
  <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(10,20,15,.88)_0%,rgba(10,20,15,.56)_45%,rgba(10,20,15,.14)_100%)]"></div>
  <div class="grid-lines absolute inset-0 opacity-40"></div>
  <div class="relative section-shell flex min-h-[45rem] flex-col justify-end pb-10 pt-36 lg:min-h-[48rem] lg:pb-14">
    <div class="max-w-4xl">
      <p class="section-kicker text-[#e6c88f]">Studio pengerjaan kayu · Jabodetabek</p>
      <h1 class="display-title text-balance mt-6 max-w-4xl text-[clamp(4rem,10vw,8.4rem)] leading-[.78]">Ruang yang terasa<br /><em class="font-medium">hidup.</em></h1>
      <p class="mt-8 max-w-xl text-base leading-7 text-white/78 sm:text-lg sm:leading-8">Kami merancang dan memasang elemen kayu yang tidak sekadar terlihat mewah, tetapi masuk akal untuk dipakai, dirawat, dan dinikmati bertahun-tahun.</p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href="#portofolio" class="btn-wood !bg-[#fffdf7] !text-[#17231d] hover:!bg-[#e8dfcf]">Jelajahi karya <span aria-hidden="true">↘</span></a>
        <a href="#kontak" class="btn-ghost !border-white/35 !text-white hover:!border-white hover:!bg-white hover:!text-[#17231d]">Mulai proyek <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="mt-14 grid max-w-3xl grid-cols-3 border-t border-white/25 pt-5 text-white/85 sm:gap-12">
      <div><p class="font-serif text-3xl leading-none sm:text-4xl">35+</p><p class="mt-2 text-[0.58rem] font-bold uppercase tracking-[.13em] text-white/60">Tahun pengalaman</p></div>
      <div><p class="font-serif text-3xl leading-none sm:text-4xl">JKT</p><p class="mt-2 text-[0.58rem] font-bold uppercase tracking-[.13em] text-white/60">Berbasis di Jakarta</p></div>
      <div><p class="font-serif text-3xl leading-none sm:text-4xl">1:1</p><p class="mt-2 text-[0.58rem] font-bold uppercase tracking-[.13em] text-white/60">Konsultasi per proyek</p></div>
    </div>
  </div>
  <a href="#layanan" class="absolute bottom-10 right-5 hidden h-24 w-24 items-center justify-center rounded-full border border-white/30 text-center text-[0.58rem] font-extrabold uppercase tracking-[.13em] text-white/90 transition hover:rotate-12 hover:bg-white hover:text-[#17231d] lg:flex">scroll<br />to explore</a>
</section>
