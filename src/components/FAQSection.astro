---
const faqs = [
  ['Bisa mulai konsultasi tanpa survei?', 'Bisa. Kirim foto area, ukuran kira-kira, lokasi, dan kebutuhan utama lewat WhatsApp. Dari situ kami bantu menentukan apakah proyek perlu survei lanjutan.'],
  ['Apa yang perlu disiapkan sebelum chat?', 'Foto area dari beberapa sudut, ukuran kasar, lokasi, referensi gaya atau material, dan target waktu. Informasi ini membuat diskusi awal jauh lebih terarah.'],
  ['Apakah proyek bisa dikerjakan bertahap?', 'Bisa untuk banyak kasus. Pengerjaan dapat dimulai dari satu area prioritas setelah scope, akses kerja, dan urutan pekerjaan disepakati.'],
  ['Area mana yang dilayani?', 'Fokus utama kami Jakarta dan Jabodetabek. Untuk area lebih jauh, kelayakan survei dan pengerjaan disesuaikan dengan jadwal serta kompleksitas proyek.'],
  ['Jenis pekerjaan apa yang paling sering masuk?', 'Lantai kayu, decking outdoor, tangga, wall panel, ceiling, serta detail custom pada hunian dan ruang komersial.'],
];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([question, answer]) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) };
---
<section id="faq" class="section-anchor bg-[#e7dfd0] py-24 sm:py-32">
  <div class="section-shell grid gap-12 lg:grid-cols-[.68fr_1.32fr] lg:gap-20">
    <div class="reveal lg:sticky lg:top-32 lg:self-start"><p class="section-kicker">Sebelum mulai</p><h2 class="display-title mt-5 text-5xl text-[#17231d] sm:text-6xl">Jawaban singkat untuk keputusan yang lebih <em>tenang.</em></h2><p class="mt-6 max-w-sm text-sm leading-7 text-[#566158]">Tidak menemukan pertanyaan Anda? Kirim detail proyek, kami bantu arahkan dari titik yang paling relevan.</p></div>
    <div class="reveal divide-y divide-[#17231d]/15 border-t border-[#17231d]/15">
      {faqs.map(([question, answer], index) => (
        <details class="group py-6"><summary class="flex cursor-pointer list-none items-center justify-between gap-5 font-serif text-2xl font-semibold tracking-[-.025em] text-[#17231d]"><span>{question}</span><span class="font-sans text-xl text-[#315443] transition-transform group-open:rotate-45" aria-hidden="true">+</span></summary><p class="max-w-2xl pt-4 text-sm leading-7 text-[#566158]">{answer}</p></details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>
