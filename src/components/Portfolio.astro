---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const categories = [
  { id: 'all', label: 'Semua' },
  { id: 'residential', label: 'Hunian' },
  { id: 'commercial', label: 'Komersial' },
  { id: 'custom', label: 'Custom' }
];

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/portfolio/**/*.{jpeg,jpg,png,gif,svg,webp}');
const fallbackPath = '/src/assets/images/portfolio/portfolio-1.svg';
const toAssetImagePath = (path?: string, slug?: string) => path?.startsWith('/images/portfolio/') ? `/src/assets${path}` : path || (slug ? `/src/assets/images/portfolio/${slug}.jpg` : undefined);

const projects = await Promise.all((await getCollection('portfolio'))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || (b.data.year ?? 0) - (a.data.year ?? 0))
  .map(async (item) => {
    const source = toAssetImagePath(item.data.image, item.id);
    const image = source && images[source] ? (await images[source]()).default : (await images[fallbackPath]()).default;
    return { ...item, image };
  }));

const featuredProject = projects[0];
const galleryProjects = projects.slice(1);
---
<section id="portofolio" class="section-anchor overflow-hidden bg-[#17352a] py-24 text-[#fffdf7] sm:py-32">
  <div class="section-shell">
    <div class="grid gap-10 lg:grid-cols-[.75fr_1fr] lg:items-end">
      <div class="reveal">
        <p class="section-kicker text-[#e6c88f]">Pilihan karya</p>
        <h2 class="display-title text-balance mt-5 text-5xl sm:text-6xl lg:text-7xl">Bukti kerja,<br /><em>bukan janji.</em></h2>
      </div>
      <p class="reveal max-w-xl text-base leading-7 text-white/70 sm:text-lg">Dokumentasi proyek memberi Anda bahan untuk menilai sendiri: arah serat, proporsi bidang, kesesuaian material, sampai cara kami menuntaskan detail di lokasi.</p>
    </div>

    {featuredProject && (
      <article class="portfolio-card reveal mt-14 grid overflow-hidden border border-white/20 bg-white/5 lg:grid-cols-[1.3fr_.7fr]" data-category={featuredProject.data.category}>
        <a href={`/portfolio/${featuredProject.id}`} class="image-zoom relative block aspect-[5/4] overflow-hidden bg-black/20 lg:aspect-auto">
          <Image src={featuredProject.image} alt={featuredProject.data.title} width={1200} height={900} format="webp" loading="eager" fetchpriority="high" class="h-full w-full object-cover" />
          <span class="absolute left-5 top-5 bg-[#f4f2eb] px-3 py-1.5 text-[0.6rem] font-extrabold uppercase tracking-[.14em] text-[#17231d]">Karya terbaru</span>
        </a>
        <div class="flex flex-col justify-between p-7 sm:p-10 lg:p-12">
          <div>
            <p class="text-[0.65rem] font-extrabold uppercase tracking-[.15em] text-[#e6c88f]">{featuredProject.data.displayCategory} · {featuredProject.data.location ?? 'Jabodetabek'}</p>
            <h3 class="mt-4 font-serif text-4xl font-semibold tracking-[-.04em] sm:text-5xl">{featuredProject.data.title}</h3>
            <p class="mt-5 max-w-md text-sm leading-7 text-white/72">{featuredProject.data.description}</p>
          </div>
          <a href={`/portfolio/${featuredProject.id}`} class="mt-10 inline-flex items-center gap-3 text-[0.67rem] font-extrabold uppercase tracking-[.13em] text-white">Baca cerita proyek <span class="text-xl leading-none" aria-hidden="true">↗</span></a>
        </div>
      </article>
    )}

    <div class="mt-14 flex flex-wrap gap-2" role="tablist" aria-label="Filter karya">
      {categories.map((category) => (
        <button class={`portfolio-filter rounded-full border px-4 py-2 text-[0.65rem] font-extrabold uppercase tracking-[.12em] transition ${category.id === 'all' ? 'border-[#e6c88f] bg-[#e6c88f] text-[#17231d]' : 'border-white/25 text-white/75 hover:border-white hover:text-white'}`} data-filter={category.id} role="tab" aria-selected={category.id === 'all' ? 'true' : 'false'}>{category.label}</button>
      ))}
    </div>
    <div class="mt-7 grid gap-x-5 gap-y-9 sm:grid-cols-2 lg:grid-cols-3">
      {galleryProjects.map((project) => (
        <article class="portfolio-card group" data-category={project.data.category}>
          <a href={`/portfolio/${project.id}`} class="image-zoom block aspect-[4/3] bg-black/20">
            <Image src={project.image} alt={project.data.title} width={720} height={540} format="webp" loading="lazy" class="h-full w-full object-cover" />
          </a>
          <div class="pt-4">
            <p class="text-[0.6rem] font-extrabold uppercase tracking-[.14em] text-[#e6c88f]">{project.data.displayCategory}</p>
            <a href={`/portfolio/${project.id}`} class="mt-2 flex items-start justify-between gap-3 font-serif text-2xl font-semibold tracking-[-.03em] text-white transition group-hover:text-[#e6c88f]"><span>{project.data.title}</span><span class="mt-1 text-lg" aria-hidden="true">↗</span></a>
            <p class="mt-2 text-sm leading-6 text-white/65">{project.data.location ?? project.data.description}</p>
          </div>
        </article>
      ))}
    </div>
    <p class="mt-12 text-center text-sm leading-6 text-white/60">Punya kebutuhan yang mirip? <a href="#kontak" class="font-bold text-[#e6c88f] underline underline-offset-4">Mulai dari foto area dan brief singkat.</a></p>
  </div>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const filters = document.querySelectorAll('.portfolio-filter');
      const cards = document.querySelectorAll('.portfolio-card');
      filters.forEach((button) => button.addEventListener('click', () => {
        const filter = button.getAttribute('data-filter');
        filters.forEach((item) => {
          const active = item === button;
          item.setAttribute('aria-selected', String(active));
          item.classList.toggle('border-[#e6c88f]', active);
          item.classList.toggle('bg-[#e6c88f]', active);
          item.classList.toggle('text-[#17231d]', active);
          item.classList.toggle('border-white/25', !active);
          item.classList.toggle('text-white/75', !active);
        });
        cards.forEach((card) => card.classList.toggle('hidden', filter !== 'all' && card.getAttribute('data-category') !== filter));
      }));
    });
  </script>
</section>
