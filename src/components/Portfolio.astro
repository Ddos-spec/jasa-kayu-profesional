---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/portfolio/**/*.{jpeg,jpg,png,gif,svg,webp}');
const fallbackPath = '/src/assets/images/portfolio/portfolio-1.svg';
const toAssetImagePath = (path?: string, slug?: string) => path?.startsWith('/images/portfolio/') ? `/src/assets${path}` : path || (slug ? `/src/assets/images/portfolio/${slug}.jpg` : undefined);

const projects = await Promise.all((await getCollection('portfolio'))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || (b.data.year ?? 0) - (a.data.year ?? 0))
  .map(async (item) => {
    const source = toAssetImagePath(item.data.image, item.id);
    const image = source && images[source] ? (await images[source]()).default : (await images[fallbackPath]()).default;
    return { ...item, image };
  }));

const featuredProject = projects[0];
const selected = projects.slice(1, 7);
const layoutClasses = [
  'lg:col-span-7 lg:pr-8',
  'lg:col-span-5 lg:pt-28',
  'lg:col-span-5 lg:col-start-2 lg:pt-10',
  'lg:col-span-6 lg:col-start-7 lg:pt-36',
  'lg:col-span-8 lg:pt-14',
  'lg:col-span-4 lg:pt-40',
];
const aspectClasses = ['aspect-[5/4]', 'aspect-[4/5]', 'aspect-[4/5]', 'aspect-[5/4]', 'aspect-[16/10]', 'aspect-[3/4]'];
---
<section id="portofolio" class="section-anchor overflow-hidden bg-[#10271e] py-24 text-[#fffdf7] sm:py-32 lg:py-40">
  <div class="section-shell">
    <div class="grid gap-10 border-b border-white/15 pb-12 lg:grid-cols-[.6fr_1.4fr] lg:items-end">
      <div class="reveal"><p class="section-kicker text-[#e6c88f]">Selected works</p></div>
      <div class="reveal">
        <h2 class="display-title text-balance max-w-5xl text-5xl sm:text-6xl lg:text-8xl">Bukti kerja harus bisa <em>dilihat dekat.</em></h2>
        <div class="mt-7 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
          <p class="max-w-2xl text-base leading-7 text-white/68 sm:text-lg">Setiap proyek membawa konteks berbeda: arah serat, cuaca, struktur, proporsi bidang, hingga cara detail bertemu material lain.</p>
          <a href="/galeri" class="group inline-flex shrink-0 items-center gap-4 text-[.66rem] font-extrabold uppercase tracking-[.14em] text-[#e6c88f]">Semua karya <span class="text-lg transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>

    {featuredProject && (
      <article class="reveal mt-14">
        <a href={`/portfolio/${featuredProject.id}`} class="group block">
          <div class="image-zoom relative aspect-[16/10] overflow-hidden bg-black/20 sm:aspect-[16/8]">
            <Image src={featuredProject.image} alt={featuredProject.data.title} width={1600} height={900} format="webp" loading="eager" fetchpriority="high" class="h-full w-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 grid gap-4 p-5 sm:p-8 lg:grid-cols-[1fr_auto] lg:items-end lg:p-10">
              <div>
                <p class="text-[.6rem] font-extrabold uppercase tracking-[.15em] text-[#e6c88f]">01 · {featuredProject.data.displayCategory} · {featuredProject.data.location ?? 'Jabodetabek'}</p>
                <h3 class="mt-3 max-w-4xl font-serif text-[clamp(2.6rem,6vw,6.2rem)] font-semibold leading-[.82] tracking-[-.055em] text-white">{featuredProject.data.title}</h3>
              </div>
              <span class="hidden h-20 w-20 items-center justify-center rounded-full border border-white/35 text-2xl transition duration-500 group-hover:rotate-12 group-hover:bg-white group-hover:text-[#17231d] sm:flex" aria-hidden="true">↗</span>
            </div>
          </div>
          <div class="mt-5 grid gap-4 border-b border-white/15 pb-7 sm:grid-cols-[1fr_1fr]">
            <p class="text-[.6rem] font-extrabold uppercase tracking-[.14em] text-white/45">Featured project {featuredProject.data.year ? `· ${featuredProject.data.year}` : ''}</p>
            <p class="max-w-xl text-sm leading-6 text-white/62 sm:justify-self-end">{featuredProject.data.description}</p>
          </div>
        </a>
      </article>
    )}

    <div class="mt-14 grid gap-x-6 gap-y-14 lg:grid-cols-12 lg:gap-y-20">
      {selected.map((project, index) => (
        <article class={`reveal group ${layoutClasses[index] ?? 'lg:col-span-6'}`}>
          <a href={`/portfolio/${project.id}`} class="block">
            <div class={`image-zoom relative overflow-hidden bg-black/20 ${aspectClasses[index] ?? 'aspect-[4/3]'}`}>
              <Image src={project.image} alt={project.data.title} width={1000} height={1000} format="webp" loading="lazy" class="h-full w-full object-cover" />
              <span class="absolute right-4 top-4 flex h-11 w-11 items-center justify-center rounded-full border border-white/35 bg-black/10 text-lg text-white opacity-0 backdrop-blur-sm transition duration-300 group-hover:opacity-100" aria-hidden="true">↗</span>
            </div>
            <div class="mt-4 grid grid-cols-[auto_1fr] gap-4 border-t border-white/15 pt-4">
              <span class="text-[.58rem] font-extrabold uppercase tracking-[.14em] text-[#e6c88f]">0{index + 2}</span>
              <div>
                <p class="text-[.58rem] font-extrabold uppercase tracking-[.14em] text-white/45">{project.data.displayCategory} · {project.data.location ?? 'Jabodetabek'}</p>
                <h3 class="mt-2 font-serif text-[clamp(2rem,3vw,3.25rem)] font-semibold leading-[.9] tracking-[-.045em] text-white transition-colors group-hover:text-[#e6c88f]">{project.data.title}</h3>
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>

    <div class="mt-24 grid gap-7 border-t border-white/15 pt-8 sm:grid-cols-[1fr_auto] sm:items-end">
      <p class="max-w-3xl font-serif text-3xl font-semibold leading-[1] tracking-[-.035em] text-white/90 sm:text-4xl">Tidak semua kebutuhan harus dimulai dari spesifikasi. Foto area dan konteks proyek sudah cukup untuk memulai pembacaan.</p>
      <a href="#kontak" class="btn-wood !bg-[#e6c88f] !text-[#17231d] hover:!bg-[#fffdf7]">Kirim brief proyek <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
