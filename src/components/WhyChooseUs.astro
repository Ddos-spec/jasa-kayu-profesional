---
const principles = [
  ['01', 'Mulai dari konteks', 'Area basah atau kering, paparan matahari, sirkulasi, hingga kebiasaan penghuni menentukan pilihan material dan sistem pemasangan.'],
  ['02', 'Detail sebelum eksekusi', 'Kami memetakan sambungan, elevasi, arah serat, dan transisi agar keputusan penting tidak muncul di menit terakhir.'],
  ['03', 'Komunikasi yang bisa diikuti', 'Brief awal, referensi, dan pembahasan scope dibuat sejelas mungkin supaya klien tahu apa yang sedang diputuskan.'],
  ['04', 'Hasil yang tetap relevan', 'Kami mengejar karakter material dan proporsi yang matang, bukan tren visual yang cepat terasa usang.'],
];
---
<section id="mengapa" class="section-anchor paper-grid bg-[#e7dfd0] py-24 sm:py-32">
  <div class="section-shell">
    <div class="grid gap-12 lg:grid-cols-[.82fr_1.18fr] lg:gap-20">
      <div class="reveal lg:sticky lg:top-32 lg:self-start">
        <p class="section-kicker">Cara kami bekerja</p>
        <h2 class="display-title text-balance mt-5 text-5xl text-[#17231d] sm:text-6xl lg:text-7xl">Tidak ada material bagus yang bisa menyelamatkan keputusan yang <em>terburu-buru.</em></h2>
        <p class="mt-7 max-w-md text-base leading-7 text-[#566158]">Pekerjaan kayu yang awet berangkat dari keputusan kecil yang tepat: jenis kayu, kondisi bidang, detail drainase, toleransi sambungan, hingga cara ruang itu digunakan setiap hari.</p>
        <a href="#kontak" class="btn-wood mt-8">Kirim brief proyek <span aria-hidden="true">↗</span></a>
      </div>
      <ol class="border-t border-[#17231d]/15">
        {principles.map(([number, title, description]) => (
          <li class="reveal grid gap-4 border-b border-[#17231d]/15 py-8 sm:grid-cols-[4rem_1fr_auto] sm:items-start sm:gap-6">
            <span class="font-serif text-3xl text-[#987755]">{number}</span>
            <div><h3 class="font-serif text-3xl font-semibold tracking-[-.035em] text-[#17231d]">{title}</h3><p class="mt-3 max-w-xl text-sm leading-7 text-[#566158]">{description}</p></div>
            <span class="hidden text-2xl text-[#315443] sm:block" aria-hidden="true">↗</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
