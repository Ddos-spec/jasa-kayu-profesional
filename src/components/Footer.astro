      <div><p class="text-[.6rem] font-extrabold uppercase tracking-[.15em] text-[#e6c88f]">Area</p><ul class="mt-5 space-y-3 text-sm text-white/62"><li>Jakarta</li><li>Bogor</li><li>Depok</li><li>Tangerang</li><li>Bekasi</li></ul></div>
      <div><p class="text-[.6rem] font-extrabold uppercase tracking-[.15em] text-[#e6c88f]">Contact</p><ul class="mt-5 space-y-3 break-words text-sm text-white/62"><li><a href="https://wa.me/6281283135295" target="_blank" rel="noopener noreferrer" class="hover:text-white">+62 812 8313 5295</a></li><li><a href="mailto:info@jasakayuprofesional.com" class="hover:text-white">info@jasakayuprofesional.com</a></li></ul></div>
