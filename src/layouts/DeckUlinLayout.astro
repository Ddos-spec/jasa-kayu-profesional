---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import GoogleAnalytics from '../components/analytics/GoogleAnalytics.astro';
import SpeedInsights from '@vercel/speed-insights/astro';

const {
  title = 'Deck Ulin Jabodetabek | Jasa Kayu Profesional',
  description = 'Spesialis perencanaan dan pemasangan decking kayu ulin untuk hunian, villa, balkon, kolam renang, dan area outdoor di Jabodetabek.',
  canonical = 'https://deckulin.jasakayuprofesional.com/',
  image = '/images/portfolio/deck-ulin-rancamaya-bogor/deck-ulin-rancamaya-bogor-1.jpg',
} = Astro.props;

const whatsappHref = 'https://wa.me/6281283135295?text=Halo%20Jasa%20Kayu%20Profesional%2C%20saya%20ingin%20konsultasi%20deck%20ulin.';
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#161d18" />
    <SEO title={title} description={description} canonical={canonical} image={image} />
    <link rel="icon" type="image/x-icon" href="/icons/wmremove-transformed.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,600&family=Manrope:wght@400;500;600;700;800&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,600&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" /></noscript>
    <GoogleAnalytics />
  </head>
  <body class="min-h-screen bg-[#f3f0e7] text-[#17231d]">
    <SpeedInsights />
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[70] focus:bg-white focus:px-4 focus:py-3">Lewati ke konten</a>

    <header id="deck-header" class="fixed inset-x-0 top-0 z-50 border-b border-white/15 text-white transition duration-300">
      <div class="section-shell flex min-h-[4.75rem] items-center justify-between gap-4">
        <a href="#hero" class="inline-flex items-center gap-3" aria-label="Deck Ulin, ke bagian atas">
          <img src="/icons/wmremove-transformed.ico" alt="" width="42" height="42" class="h-10 w-10 object-contain" aria-hidden="true" />
          <span class="leading-none">
            <span class="block font-serif text-xl font-semibold tracking-[-.04em]">Deck Ulin</span>
            <span class="mt-1 block text-[.54rem] font-extrabold uppercase tracking-[.16em] text-current/65">by Jasa Kayu Profesional</span>
          </span>
        </a>
        <nav class="hidden items-center gap-6 text-[.62rem] font-extrabold uppercase tracking-[.12em] md:flex" aria-label="Navigasi Deck Ulin">
          <a href="#material" class="hover:opacity-65">Material</a>
          <a href="#dokumentasi" class="hover:opacity-65">Dokumentasi</a>
          <a href="#sistem" class="hover:opacity-65">Sistem</a>
          <a href="#faq" class="hover:opacity-65">FAQ</a>
        </nav>
        <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-10 items-center rounded-full border border-current/30 px-4 text-[.6rem] font-extrabold uppercase tracking-[.1em] transition hover:bg-white hover:text-[#17231d]">Konsultasi <span class="ml-2" aria-hidden="true">↗</span></a>
      </div>
    </header>

    <main id="main-content"><slot /></main>

    <footer class="bg-[#101612] text-white">
      <div class="section-shell grid gap-8 py-10 sm:grid-cols-[1fr_auto] sm:items-end">
        <div><p class="font-serif text-3xl font-semibold tracking-[-.04em]">Deck Ulin</p><p class="mt-3 max-w-xl text-sm leading-6 text-white/55">Fokus pada satu pekerjaan: decking kayu ulin untuk area outdoor yang perlu tetap masuk akal setelah panas, hujan, dan pemakaian harian.</p></div>
        <div class="text-sm text-white/65 sm:text-right"><a href="tel:+6281283135295" class="block hover:text-white">+62 812 8313 5295</a><a href="mailto:alimruswandi@gmail.com" class="mt-2 block hover:text-white">alimruswandi@gmail.com</a></div>
      </div>
      <div class="border-t border-white/10"><div class="section-shell py-5 text-[.6rem] font-bold uppercase tracking-[.11em] text-white/35">© {new Date().getFullYear()} Jasa Kayu Profesional · Deck Ulin</div></div>
    </footer>

    <a href={whatsappHref} target="_blank" rel="noopener noreferrer" aria-label="Konsultasi Deck Ulin via WhatsApp" class="fixed bottom-5 right-5 z-40 inline-flex h-14 w-14 items-center justify-center rounded-full bg-[#1f6045] text-white shadow-[0_10px_30px_rgba(0,0,0,.25)] transition hover:scale-105">
      <span class="text-[.62rem] font-extrabold uppercase tracking-[.08em]">WA</span>
    </a>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const header = document.getElementById('deck-header');
        const updateHeader = () => header?.classList.toggle('deck-header-scrolled', window.scrollY > 24);
        updateHeader();
        window.addEventListener('scroll', updateHeader, { passive: true });
      });
    </script>
  </body>
</html>

<style is:global>
  .deck-header-scrolled { color: #17231d; border-color: rgba(23,35,29,.12); background: rgba(243,240,231,.94); backdrop-filter: blur(16px); box-shadow: 0 8px 28px rgba(16,22,18,.05); }
</style>
