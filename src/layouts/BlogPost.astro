---
import { Image } from 'astro:assets';
import { type CollectionEntry, render } from 'astro:content';
import Layout from './Layout.astro';

interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
const { Content } = await render(post);
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/blog/**/*.{jpeg,jpg,png,gif,svg}');
const rawPath = post.data.image ?? '/images/blog/blog-1.jpg';
const imagePath = rawPath.replace(/^\/images\/blog\//, '/src/assets/images/blog/');
const resolvedImage = images[imagePath] ? (await images[imagePath]()).default : (await images['/src/assets/images/blog/blog-1.jpg']()).default;
const formattedDate = new Intl.DateTimeFormat('id-ID', { year: 'numeric', month: 'long', day: 'numeric' }).format(post.data.pubDate);
---
<Layout title={`${post.data.title} | Jurnal Jasa Kayu`} description={post.data.description} canonical={`https://www.jasakayuprofesional.com/blog/${post.id}/`} image={rawPath} type="article" publishDate={post.data.pubDate}>
  <article class="bg-[#f4f2eb] pb-24 pt-32 sm:pt-40">
    <header class="section-shell grid gap-8 border-b border-[#17231d]/15 pb-10 lg:grid-cols-[.78fr_1.22fr] lg:items-end">
      <div><a href="/blog" class="section-kicker hover:text-[#17352a]">Kembali ke jurnal</a></div>
      <div><p class="text-[.65rem] font-extrabold uppercase tracking-[.14em] text-[#315443]">{post.data.category ?? 'Jurnal material'} · <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time></p><h1 class="display-title text-balance mt-4 text-5xl text-[#17231d] sm:text-6xl lg:text-7xl">{post.data.title}</h1><p class="mt-6 max-w-2xl text-base leading-7 text-[#566158] sm:text-lg">{post.data.description}</p></div>
    </header>
    <div class="section-shell mt-10 max-w-[66rem]"><Image src={resolvedImage} alt={post.data.title} class="aspect-[16/8] w-full object-cover" width={1400} height={700} loading="eager" fetchpriority="high" format="webp" /></div>
    <div class="section-shell mt-12 grid gap-10 lg:grid-cols-[10rem_minmax(0,46rem)] lg:justify-center"><aside class="hidden lg:block"><p class="text-[.6rem] font-extrabold uppercase tracking-[.15em] text-[#6c766d]">Bagikan insight</p><a href="#kontak" class="mt-3 inline-flex text-sm font-bold text-[#315443] underline underline-offset-4">Diskusikan proyek ↗</a></aside><div class="prose max-w-none"><Content /><div class="mt-14 border border-[#17231d]/15 bg-[#e7dfd0] p-7 sm:p-9"><p class="section-kicker">Langkah berikutnya</p><h2 class="mt-5 !text-4xl">Punya kondisi proyek yang ingin dicek?</h2><p>Foto area, ukuran kasar, lokasi, dan referensi visual sudah cukup untuk membuka diskusi awal yang lebih terarah.</p><a href="/#kontak" class="btn-wood mt-7 no-underline">Kirim brief proyek <span aria-hidden="true">↗</span></a></div></div></div>
  </article>
</Layout>
